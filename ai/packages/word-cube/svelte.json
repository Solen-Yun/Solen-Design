{"id":"word-cube","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"WordCube.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountWordCube, type WordCubeOptions } from \"../../components/word-cube/WordCubeEngine.js\";\nimport type { MotionController } from \"../../components/word-cube/motion-runtime\";\nexport let options: WordCubeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountWordCube(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"word-cube\"></div>\n"}],"core":[{"name":"WordCubeEngine.js","path":"src/components/word-cube/WordCubeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/word-cube/motion-runtime.ts"},{"name":"WordCubeEngine.d.ts","path":"src/components/word-cube/WordCubeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { WordCube } from \"solen-design/svelte\";\n</script>\n\n<WordCube />"}],"api":[{"name":"options","type":"WordCubeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/word-cube/SPEC.md","detail":"../../components/word-cube.json"}