{"id":"detail-side-panel","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DetailSidePanel.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDetailSidePanel, type DetailSidePanelOptions } from \"../../components/detail-side-panel/DetailSidePanelEngine.js\";\nimport type { MotionController } from \"../../components/detail-side-panel/motion-runtime\";\nexport let options: DetailSidePanelOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDetailSidePanel(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"detail-side-panel\"></div>\n"}],"core":[{"name":"DetailSidePanelEngine.js","path":"src/components/detail-side-panel/DetailSidePanelEngine.js"},{"name":"motion-runtime.ts","path":"src/components/detail-side-panel/motion-runtime.ts"},{"name":"DetailSidePanelEngine.d.ts","path":"src/components/detail-side-panel/DetailSidePanelEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DetailSidePanel } from \"solen-design/svelte\";\n</script>\n\n<DetailSidePanel />"}],"api":[{"name":"options","type":"DetailSidePanelOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/detail-side-panel/SPEC.md","detail":"../../components/detail-side-panel.json"}