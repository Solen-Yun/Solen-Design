{"id":"index-scrubber","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"IndexScrubber.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountIndexScrubber, type IndexScrubberOptions } from \"../../components/index-scrubber/IndexScrubberEngine.js\";\nimport type { MotionController } from \"../../components/index-scrubber/motion-runtime\";\nexport let options: IndexScrubberOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountIndexScrubber(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"index-scrubber\"></div>\n"}],"core":[{"name":"IndexScrubberEngine.js","path":"src/components/index-scrubber/IndexScrubberEngine.js"},{"name":"motion-runtime.ts","path":"src/components/index-scrubber/motion-runtime.ts"},{"name":"IndexScrubberEngine.d.ts","path":"src/components/index-scrubber/IndexScrubberEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { IndexScrubber } from \"solen-design/svelte\";\n</script>\n\n<IndexScrubber />"}],"api":[{"name":"options","type":"IndexScrubberOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/index-scrubber/SPEC.md","detail":"../../components/index-scrubber.json"}