{"id":"detail-expand","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DetailExpand.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDetailExpand, type DetailExpandOptions } from \"../../components/detail-expand/DetailExpandEngine.js\";\nimport type { MotionController } from \"../../components/detail-expand/motion-runtime\";\nexport let options: DetailExpandOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDetailExpand(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"detail-expand\"></div>\n"}],"core":[{"name":"DetailExpandEngine.js","path":"src/components/detail-expand/DetailExpandEngine.js"},{"name":"motion-runtime.ts","path":"src/components/detail-expand/motion-runtime.ts"},{"name":"DetailExpandEngine.d.ts","path":"src/components/detail-expand/DetailExpandEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DetailExpand } from \"solen-design/svelte\";\n</script>\n\n<DetailExpand />"}],"api":[{"name":"options","type":"DetailExpandOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/detail-expand/SPEC.md","detail":"../../components/detail-expand.json"}