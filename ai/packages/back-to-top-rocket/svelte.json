{"id":"back-to-top-rocket","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BackToTopRocket.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBackToTopRocket, type BackToTopRocketOptions } from \"../../components/back-to-top-rocket/BackToTopRocketEngine.js\";\nimport type { MotionController } from \"../../components/back-to-top-rocket/motion-runtime\";\nexport let options: BackToTopRocketOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBackToTopRocket(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"back-to-top-rocket\"></div>\n"}],"core":[{"name":"BackToTopRocketEngine.js","path":"src/components/back-to-top-rocket/BackToTopRocketEngine.js"},{"name":"motion-runtime.ts","path":"src/components/back-to-top-rocket/motion-runtime.ts"},{"name":"BackToTopRocketEngine.d.ts","path":"src/components/back-to-top-rocket/BackToTopRocketEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BackToTopRocket } from \"solen-design/svelte\";\n</script>\n\n<BackToTopRocket />"}],"api":[{"name":"options","type":"BackToTopRocketOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/back-to-top-rocket/SPEC.md","detail":"../../components/back-to-top-rocket.json"}