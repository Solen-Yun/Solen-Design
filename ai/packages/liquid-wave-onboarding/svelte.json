{"id":"liquid-wave-onboarding","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LiquidWaveOnboarding.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLiquidWaveOnboarding, type LiquidWaveOnboardingOptions } from \"../../components/liquid-wave-onboarding/LiquidWaveOnboardingEngine.js\";\nimport type { MotionController } from \"../../components/liquid-wave-onboarding/motion-runtime\";\nexport let options: LiquidWaveOnboardingOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLiquidWaveOnboarding(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"liquid-wave-onboarding\"></div>\n"}],"core":[{"name":"LiquidWaveOnboardingEngine.js","path":"src/components/liquid-wave-onboarding/LiquidWaveOnboardingEngine.js"},{"name":"motion-runtime.ts","path":"src/components/liquid-wave-onboarding/motion-runtime.ts"},{"name":"LiquidWaveOnboardingEngine.d.ts","path":"src/components/liquid-wave-onboarding/LiquidWaveOnboardingEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LiquidWaveOnboarding } from \"solen-design/svelte\";\n</script>\n\n<LiquidWaveOnboarding />"}],"api":[{"name":"options","type":"LiquidWaveOnboardingOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/liquid-wave-onboarding/SPEC.md","detail":"../../components/liquid-wave-onboarding.json"}