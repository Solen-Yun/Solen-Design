{"id":"team-invite","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TeamInvite.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTeamInvite, type TeamInviteOptions } from \"../../components/team-invite/TeamInviteEngine.js\";\nimport type { MotionController } from \"../../components/team-invite/motion-runtime\";\nexport let options: TeamInviteOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTeamInvite(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"team-invite\"></div>\n"}],"core":[{"name":"TeamInviteEngine.js","path":"src/components/team-invite/TeamInviteEngine.js"},{"name":"motion-runtime.ts","path":"src/components/team-invite/motion-runtime.ts"},{"name":"TeamInviteEngine.d.ts","path":"src/components/team-invite/TeamInviteEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TeamInvite } from \"solen-design/svelte\";\n</script>\n\n<TeamInvite />"}],"api":[{"name":"options","type":"TeamInviteOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/team-invite/SPEC.md","detail":"../../components/team-invite.json"}