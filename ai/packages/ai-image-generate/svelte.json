{"id":"ai-image-generate","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AiImageGenerate.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAiImageGenerate, type AiImageGenerateOptions } from \"../../components/ai-image-generate/AiImageGenerateEngine.js\";\nimport type { MotionController } from \"../../components/ai-image-generate/motion-runtime\";\nexport let options: AiImageGenerateOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAiImageGenerate(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"ai-image-generate\"></div>\n"}],"core":[{"name":"AiImageGenerateEngine.js","path":"src/components/ai-image-generate/AiImageGenerateEngine.js"},{"name":"motion-runtime.ts","path":"src/components/ai-image-generate/motion-runtime.ts"},{"name":"AiImageGenerateEngine.d.ts","path":"src/components/ai-image-generate/AiImageGenerateEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AiImageGenerate } from \"solen-design/svelte\";\n</script>\n\n<AiImageGenerate />"}],"api":[{"name":"options","type":"AiImageGenerateOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/ai-image-generate/SPEC.md","detail":"../../components/ai-image-generate.json"}