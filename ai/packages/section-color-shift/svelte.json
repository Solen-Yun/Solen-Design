{"id":"section-color-shift","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SectionColorShift.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSectionColorShift, type SectionColorShiftOptions } from \"../../components/section-color-shift/SectionColorShiftEngine.js\";\nimport type { MotionController } from \"../../components/section-color-shift/motion-runtime\";\nexport let options: SectionColorShiftOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSectionColorShift(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"section-color-shift\"></div>\n"}],"core":[{"name":"SectionColorShiftEngine.js","path":"src/components/section-color-shift/SectionColorShiftEngine.js"},{"name":"motion-runtime.ts","path":"src/components/section-color-shift/motion-runtime.ts"},{"name":"SectionColorShiftEngine.d.ts","path":"src/components/section-color-shift/SectionColorShiftEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SectionColorShift } from \"solen-design/svelte\";\n</script>\n\n<SectionColorShift />"}],"api":[{"name":"options","type":"SectionColorShiftOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/section-color-shift/SPEC.md","detail":"../../components/section-color-shift.json"}