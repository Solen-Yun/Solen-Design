{"id":"drag-card-carousel","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DragCardCarousel.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDragCardCarousel, type DragCardCarouselOptions } from \"../../components/drag-card-carousel/DragCardCarouselEngine.js\";\nimport type { MotionController } from \"../../components/drag-card-carousel/motion-runtime\";\nexport let options: DragCardCarouselOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDragCardCarousel(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"drag-card-carousel\"></div>\n"}],"core":[{"name":"DragCardCarouselEngine.js","path":"src/components/drag-card-carousel/DragCardCarouselEngine.js"},{"name":"motion-runtime.ts","path":"src/components/drag-card-carousel/motion-runtime.ts"},{"name":"DragCardCarouselEngine.d.ts","path":"src/components/drag-card-carousel/DragCardCarouselEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DragCardCarousel } from \"solen-design/svelte\";\n</script>\n\n<DragCardCarousel />"}],"api":[{"name":"options","type":"DragCardCarouselOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/drag-card-carousel/SPEC.md","detail":"../../components/drag-card-carousel.json"}