{"id":"automation-flow","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AutomationFlow.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAutomationFlow, type AutomationFlowOptions } from \"../../components/automation-flow/AutomationFlowEngine.js\";\nimport type { MotionController } from \"../../components/automation-flow/motion-runtime\";\nexport let options: AutomationFlowOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAutomationFlow(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"automation-flow\"></div>\n"}],"core":[{"name":"AutomationFlowEngine.js","path":"src/components/automation-flow/AutomationFlowEngine.js"},{"name":"motion-runtime.ts","path":"src/components/automation-flow/motion-runtime.ts"},{"name":"AutomationFlowEngine.d.ts","path":"src/components/automation-flow/AutomationFlowEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AutomationFlow } from \"solen-design/svelte\";\n</script>\n\n<AutomationFlow />"}],"api":[{"name":"options","type":"AutomationFlowOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/automation-flow/SPEC.md","detail":"../../components/automation-flow.json"}