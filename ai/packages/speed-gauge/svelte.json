{"id":"speed-gauge","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SpeedGauge.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSpeedGauge, type SpeedGaugeOptions } from \"../../components/speed-gauge/SpeedGaugeEngine.js\";\nimport type { MotionController } from \"../../components/speed-gauge/motion-runtime\";\nexport let options: SpeedGaugeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSpeedGauge(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"speed-gauge\"></div>\n"}],"core":[{"name":"SpeedGaugeEngine.js","path":"src/components/speed-gauge/SpeedGaugeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/speed-gauge/motion-runtime.ts"},{"name":"SpeedGaugeEngine.d.ts","path":"src/components/speed-gauge/SpeedGaugeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SpeedGauge } from \"solen-design/svelte\";\n</script>\n\n<SpeedGauge />"}],"api":[{"name":"options","type":"SpeedGaugeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/speed-gauge/SPEC.md","detail":"../../components/speed-gauge.json"}