{"id":"circular-theme-switch","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CircularThemeSwitch.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCircularThemeSwitch, type CircularThemeSwitchOptions } from \"../../components/circular-theme-switch/CircularThemeSwitchEngine.js\";\nimport type { MotionController } from \"../../components/circular-theme-switch/motion-runtime\";\nexport let options: CircularThemeSwitchOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCircularThemeSwitch(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"circular-theme-switch\"></div>\n"}],"core":[{"name":"CircularThemeSwitchEngine.js","path":"src/components/circular-theme-switch/CircularThemeSwitchEngine.js"},{"name":"motion-runtime.ts","path":"src/components/circular-theme-switch/motion-runtime.ts"},{"name":"CircularThemeSwitchEngine.d.ts","path":"src/components/circular-theme-switch/CircularThemeSwitchEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CircularThemeSwitch } from \"solen-design/svelte\";\n</script>\n\n<CircularThemeSwitch />"}],"api":[{"name":"options","type":"CircularThemeSwitchOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/circular-theme-switch/SPEC.md","detail":"../../components/circular-theme-switch.json"}