{"id":"scrollspy-toc","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ScrollspyToc.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountScrollspyToc, type ScrollspyTocOptions } from \"../../components/scrollspy-toc/ScrollspyTocEngine.js\";\nimport type { MotionController } from \"../../components/scrollspy-toc/motion-runtime\";\nexport let options: ScrollspyTocOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountScrollspyToc(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"scrollspy-toc\"></div>\n"}],"core":[{"name":"ScrollspyTocEngine.js","path":"src/components/scrollspy-toc/ScrollspyTocEngine.js"},{"name":"motion-runtime.ts","path":"src/components/scrollspy-toc/motion-runtime.ts"},{"name":"ScrollspyTocEngine.d.ts","path":"src/components/scrollspy-toc/ScrollspyTocEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ScrollspyToc } from \"solen-design/svelte\";\n</script>\n\n<ScrollspyToc />"}],"api":[{"name":"options","type":"ScrollspyTocOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/scrollspy-toc/SPEC.md","detail":"../../components/scrollspy-toc.json"}