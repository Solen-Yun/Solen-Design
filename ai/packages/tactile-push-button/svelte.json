{"id":"tactile-push-button","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TactilePushButton.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTactilePushButton, type TactilePushButtonOptions } from \"../../components/tactile-push-button/TactilePushButtonEngine.js\";\nimport type { MotionController } from \"../../components/tactile-push-button/motion-runtime\";\nexport let options: TactilePushButtonOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTactilePushButton(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"tactile-push-button\"></div>\n"}],"core":[{"name":"TactilePushButtonEngine.js","path":"src/components/tactile-push-button/TactilePushButtonEngine.js"},{"name":"motion-runtime.ts","path":"src/components/tactile-push-button/motion-runtime.ts"},{"name":"TactilePushButtonEngine.d.ts","path":"src/components/tactile-push-button/TactilePushButtonEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TactilePushButton } from \"solen-design/svelte\";\n</script>\n\n<TactilePushButton />"}],"api":[{"name":"options","type":"TactilePushButtonOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/tactile-push-button/SPEC.md","detail":"../../components/tactile-push-button.json"}