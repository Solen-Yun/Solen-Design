{"id":"infinite-spiral","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"InfiniteSpiral.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountInfiniteSpiral, type InfiniteSpiralOptions } from \"../../components/infinite-spiral/InfiniteSpiralEngine.js\";\ntype Controller = ReturnType<typeof mountInfiniteSpiral>;\nexport let options: InfiniteSpiralOptions = {};\nlet host: HTMLDivElement;\nlet controller: Controller | undefined;\nonMount(() => {\n  const instance = mountInfiniteSpiral(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"infinite-spiral\"></div>\n"}],"core":[{"name":"InfiniteSpiralEngine.js","path":"src/components/infinite-spiral/InfiniteSpiralEngine.js"},{"name":"motion-runtime.ts","path":"src/components/infinite-spiral/motion-runtime.ts"},{"name":"InfiniteSpiralEngine.d.ts","path":"src/components/infinite-spiral/InfiniteSpiralEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { InfiniteSpiral } from \"solen-design/svelte\";\n</script>\n\n<div style=\"height: 600px\">\n  <InfiniteSpiral {items} animationMode=\"all\" />\n</div>"}],"api":[{"name":"options","type":"InfiniteSpiralOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/infinite-spiral/SPEC.md","detail":"../../components/infinite-spiral.json"}