{"id":"store-locator","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StoreLocator.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStoreLocator, type StoreLocatorOptions } from \"../../components/store-locator/StoreLocatorEngine.js\";\nimport type { MotionController } from \"../../components/store-locator/motion-runtime\";\nexport let options: StoreLocatorOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStoreLocator(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"store-locator\"></div>\n"}],"core":[{"name":"StoreLocatorEngine.js","path":"src/components/store-locator/StoreLocatorEngine.js"},{"name":"motion-runtime.ts","path":"src/components/store-locator/motion-runtime.ts"},{"name":"StoreLocatorEngine.d.ts","path":"src/components/store-locator/StoreLocatorEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StoreLocator } from \"solen-design/svelte\";\n</script>\n\n<StoreLocator />"}],"api":[{"name":"options","type":"StoreLocatorOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/store-locator/SPEC.md","detail":"../../components/store-locator.json"}