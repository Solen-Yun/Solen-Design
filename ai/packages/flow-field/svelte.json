{"id":"flow-field","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FlowField.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFlowField, type FlowFieldOptions } from \"../../components/flow-field/FlowFieldEngine.js\";\nimport type { MotionController } from \"../../components/flow-field/motion-runtime\";\nexport let options: FlowFieldOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFlowField(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"flow-field\"></div>\n"}],"core":[{"name":"FlowFieldEngine.js","path":"src/components/flow-field/FlowFieldEngine.js"},{"name":"motion-runtime.ts","path":"src/components/flow-field/motion-runtime.ts"},{"name":"FlowFieldEngine.d.ts","path":"src/components/flow-field/FlowFieldEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FlowField } from \"solen-design/svelte\";\n</script>\n\n<FlowField />"}],"api":[{"name":"options","type":"FlowFieldOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/flow-field/SPEC.md","detail":"../../components/flow-field.json"}