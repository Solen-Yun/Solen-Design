{"id":"logo-wall-cycle","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LogoWallCycle.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLogoWallCycle, type LogoWallCycleOptions } from \"../../components/logo-wall-cycle/LogoWallCycleEngine.js\";\nimport type { MotionController } from \"../../components/logo-wall-cycle/motion-runtime\";\nexport let options: LogoWallCycleOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLogoWallCycle(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"logo-wall-cycle\"></div>\n"}],"core":[{"name":"LogoWallCycleEngine.js","path":"src/components/logo-wall-cycle/LogoWallCycleEngine.js"},{"name":"motion-runtime.ts","path":"src/components/logo-wall-cycle/motion-runtime.ts"},{"name":"LogoWallCycleEngine.d.ts","path":"src/components/logo-wall-cycle/LogoWallCycleEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LogoWallCycle } from \"solen-design/svelte\";\n</script>\n\n<LogoWallCycle />"}],"api":[{"name":"options","type":"LogoWallCycleOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/logo-wall-cycle/SPEC.md","detail":"../../components/logo-wall-cycle.json"}