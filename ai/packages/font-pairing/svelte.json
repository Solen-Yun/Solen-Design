{"id":"font-pairing","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FontPairing.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFontPairing, type FontPairingOptions } from \"../../components/font-pairing/FontPairingEngine.js\";\nimport type { MotionController } from \"../../components/font-pairing/motion-runtime\";\nexport let options: FontPairingOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFontPairing(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"font-pairing\"></div>\n"}],"core":[{"name":"FontPairingEngine.js","path":"src/components/font-pairing/FontPairingEngine.js"},{"name":"motion-runtime.ts","path":"src/components/font-pairing/motion-runtime.ts"},{"name":"FontPairingEngine.d.ts","path":"src/components/font-pairing/FontPairingEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FontPairing } from \"solen-design/svelte\";\n</script>\n\n<FontPairing />"}],"api":[{"name":"options","type":"FontPairingOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/font-pairing/SPEC.md","detail":"../../components/font-pairing.json"}