{"id":"integration-orbit","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"IntegrationOrbit.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountIntegrationOrbit, type IntegrationOrbitOptions } from \"../../components/integration-orbit/IntegrationOrbitEngine.js\";\nimport type { MotionController } from \"../../components/integration-orbit/motion-runtime\";\nexport let options: IntegrationOrbitOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountIntegrationOrbit(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"integration-orbit\"></div>\n"}],"core":[{"name":"IntegrationOrbitEngine.js","path":"src/components/integration-orbit/IntegrationOrbitEngine.js"},{"name":"motion-runtime.ts","path":"src/components/integration-orbit/motion-runtime.ts"},{"name":"IntegrationOrbitEngine.d.ts","path":"src/components/integration-orbit/IntegrationOrbitEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { IntegrationOrbit } from \"solen-design/svelte\";\n</script>\n\n<IntegrationOrbit />"}],"api":[{"name":"options","type":"IntegrationOrbitOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/integration-orbit/SPEC.md","detail":"../../components/integration-orbit.json"}