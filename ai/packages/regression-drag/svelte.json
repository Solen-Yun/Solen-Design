{"id":"regression-drag","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"RegressionDrag.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountRegressionDrag, type RegressionDragOptions } from \"../../components/regression-drag/RegressionDragEngine.js\";\nimport type { MotionController } from \"../../components/regression-drag/motion-runtime\";\nexport let options: RegressionDragOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountRegressionDrag(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"regression-drag\"></div>\n"}],"core":[{"name":"RegressionDragEngine.js","path":"src/components/regression-drag/RegressionDragEngine.js"},{"name":"motion-runtime.ts","path":"src/components/regression-drag/motion-runtime.ts"},{"name":"RegressionDragEngine.d.ts","path":"src/components/regression-drag/RegressionDragEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { RegressionDrag } from \"solen-design/svelte\";\n</script>\n\n<RegressionDrag />"}],"api":[{"name":"options","type":"RegressionDragOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/regression-drag/SPEC.md","detail":"../../components/regression-drag.json"}