{"id":"long-press-peek","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LongPressPeek.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLongPressPeek, type LongPressPeekOptions } from \"../../components/long-press-peek/LongPressPeekEngine.js\";\nimport type { MotionController } from \"../../components/long-press-peek/motion-runtime\";\nexport let options: LongPressPeekOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLongPressPeek(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"long-press-peek\"></div>\n"}],"core":[{"name":"LongPressPeekEngine.js","path":"src/components/long-press-peek/LongPressPeekEngine.js"},{"name":"motion-runtime.ts","path":"src/components/long-press-peek/motion-runtime.ts"},{"name":"LongPressPeekEngine.d.ts","path":"src/components/long-press-peek/LongPressPeekEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LongPressPeek } from \"solen-design/svelte\";\n</script>\n\n<LongPressPeek />"}],"api":[{"name":"options","type":"LongPressPeekOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/long-press-peek/SPEC.md","detail":"../../components/long-press-peek.json"}