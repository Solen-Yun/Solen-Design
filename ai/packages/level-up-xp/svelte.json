{"id":"level-up-xp","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LevelUpXp.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLevelUpXp, type LevelUpXpOptions } from \"../../components/level-up-xp/LevelUpXpEngine.js\";\nimport type { MotionController } from \"../../components/level-up-xp/motion-runtime\";\nexport let options: LevelUpXpOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLevelUpXp(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"level-up-xp\"></div>\n"}],"core":[{"name":"LevelUpXpEngine.js","path":"src/components/level-up-xp/LevelUpXpEngine.js"},{"name":"motion-runtime.ts","path":"src/components/level-up-xp/motion-runtime.ts"},{"name":"LevelUpXpEngine.d.ts","path":"src/components/level-up-xp/LevelUpXpEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LevelUpXp } from \"solen-design/svelte\";\n</script>\n\n<LevelUpXp />"}],"api":[{"name":"options","type":"LevelUpXpOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/level-up-xp/SPEC.md","detail":"../../components/level-up-xp.json"}