{"id":"feedback-pins","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FeedbackPins.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFeedbackPins, type FeedbackPinsOptions } from \"../../components/feedback-pins/FeedbackPinsEngine.js\";\nimport type { MotionController } from \"../../components/feedback-pins/motion-runtime\";\nexport let options: FeedbackPinsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFeedbackPins(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"feedback-pins\"></div>\n"}],"core":[{"name":"FeedbackPinsEngine.js","path":"src/components/feedback-pins/FeedbackPinsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/feedback-pins/motion-runtime.ts"},{"name":"FeedbackPinsEngine.d.ts","path":"src/components/feedback-pins/FeedbackPinsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FeedbackPins } from \"solen-design/svelte\";\n</script>\n\n<FeedbackPins />"}],"api":[{"name":"options","type":"FeedbackPinsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/feedback-pins/SPEC.md","detail":"../../components/feedback-pins.json"}