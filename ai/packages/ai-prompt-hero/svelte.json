{"id":"ai-prompt-hero","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AiPromptHero.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAiPromptHero, type AiPromptHeroOptions } from \"../../components/ai-prompt-hero/AiPromptHeroEngine.js\";\nimport type { MotionController } from \"../../components/ai-prompt-hero/motion-runtime\";\nexport let options: AiPromptHeroOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAiPromptHero(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"ai-prompt-hero\"></div>\n"}],"core":[{"name":"AiPromptHeroEngine.js","path":"src/components/ai-prompt-hero/AiPromptHeroEngine.js"},{"name":"motion-runtime.ts","path":"src/components/ai-prompt-hero/motion-runtime.ts"},{"name":"AiPromptHeroEngine.d.ts","path":"src/components/ai-prompt-hero/AiPromptHeroEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AiPromptHero } from \"solen-design/svelte\";\n</script>\n\n<AiPromptHero />"}],"api":[{"name":"options","type":"AiPromptHeroOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/ai-prompt-hero/SPEC.md","detail":"../../components/ai-prompt-hero.json"}