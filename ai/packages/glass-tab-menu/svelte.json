{"id":"glass-tab-menu","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GlassTabMenu.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGlassTabMenu, type GlassTabMenuOptions } from \"../../components/glass-tab-menu/GlassTabMenuEngine.js\";\nimport type { MotionController } from \"../../components/glass-tab-menu/motion-runtime\";\nexport let options: GlassTabMenuOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGlassTabMenu(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"glass-tab-menu\"></div>\n"}],"core":[{"name":"GlassTabMenuEngine.js","path":"src/components/glass-tab-menu/GlassTabMenuEngine.js"},{"name":"motion-runtime.ts","path":"src/components/glass-tab-menu/motion-runtime.ts"},{"name":"GlassTabMenuEngine.d.ts","path":"src/components/glass-tab-menu/GlassTabMenuEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GlassTabMenu } from \"solen-design/svelte\";\n</script>\n\n<GlassTabMenu />"}],"api":[{"name":"options","type":"GlassTabMenuOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/glass-tab-menu/SPEC.md","detail":"../../components/glass-tab-menu.json"}