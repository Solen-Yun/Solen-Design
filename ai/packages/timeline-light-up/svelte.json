{"id":"timeline-light-up","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TimelineLightUp.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTimelineLightUp, type TimelineLightUpOptions } from \"../../components/timeline-light-up/TimelineLightUpEngine.js\";\nimport type { MotionController } from \"../../components/timeline-light-up/motion-runtime\";\nexport let options: TimelineLightUpOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTimelineLightUp(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"timeline-light-up\"></div>\n"}],"core":[{"name":"TimelineLightUpEngine.js","path":"src/components/timeline-light-up/TimelineLightUpEngine.js"},{"name":"motion-runtime.ts","path":"src/components/timeline-light-up/motion-runtime.ts"},{"name":"TimelineLightUpEngine.d.ts","path":"src/components/timeline-light-up/TimelineLightUpEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TimelineLightUp } from \"solen-design/svelte\";\n</script>\n\n<TimelineLightUp />"}],"api":[{"name":"options","type":"TimelineLightUpOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/timeline-light-up/SPEC.md","detail":"../../components/timeline-light-up.json"}