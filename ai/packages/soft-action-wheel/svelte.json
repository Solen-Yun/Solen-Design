{"id":"soft-action-wheel","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SoftActionWheel.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSoftActionWheel, type SoftActionWheelOptions } from \"../../components/soft-action-wheel/SoftActionWheelEngine.js\";\nimport type { MotionController } from \"../../components/soft-action-wheel/motion-runtime\";\nexport let options: SoftActionWheelOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSoftActionWheel(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"soft-action-wheel\"></div>\n"}],"core":[{"name":"SoftActionWheelEngine.js","path":"src/components/soft-action-wheel/SoftActionWheelEngine.js"},{"name":"motion-runtime.ts","path":"src/components/soft-action-wheel/motion-runtime.ts"},{"name":"SoftActionWheelEngine.d.ts","path":"src/components/soft-action-wheel/SoftActionWheelEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SoftActionWheel } from \"solen-design/svelte\";\n</script>\n\n<SoftActionWheel />"}],"api":[{"name":"options","type":"SoftActionWheelOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/soft-action-wheel/SPEC.md","detail":"../../components/soft-action-wheel.json"}