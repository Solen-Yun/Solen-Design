{"id":"collapsing-large-title","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CollapsingLargeTitle.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCollapsingLargeTitle, type CollapsingLargeTitleOptions } from \"../../components/collapsing-large-title/CollapsingLargeTitleEngine.js\";\nimport type { MotionController } from \"../../components/collapsing-large-title/motion-runtime\";\nexport let options: CollapsingLargeTitleOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCollapsingLargeTitle(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"collapsing-large-title\"></div>\n"}],"core":[{"name":"CollapsingLargeTitleEngine.js","path":"src/components/collapsing-large-title/CollapsingLargeTitleEngine.js"},{"name":"motion-runtime.ts","path":"src/components/collapsing-large-title/motion-runtime.ts"},{"name":"CollapsingLargeTitleEngine.d.ts","path":"src/components/collapsing-large-title/CollapsingLargeTitleEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CollapsingLargeTitle } from \"solen-design/svelte\";\n</script>\n\n<CollapsingLargeTitle />"}],"api":[{"name":"options","type":"CollapsingLargeTitleOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/collapsing-large-title/SPEC.md","detail":"../../components/collapsing-large-title.json"}