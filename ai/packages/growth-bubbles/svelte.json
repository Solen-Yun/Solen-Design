{"id":"growth-bubbles","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GrowthBubbles.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGrowthBubbles, type GrowthBubblesOptions } from \"../../components/growth-bubbles/GrowthBubblesEngine.js\";\nimport type { MotionController } from \"../../components/growth-bubbles/motion-runtime\";\nexport let options: GrowthBubblesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGrowthBubbles(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"growth-bubbles\"></div>\n"}],"core":[{"name":"GrowthBubblesEngine.js","path":"src/components/growth-bubbles/GrowthBubblesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/growth-bubbles/motion-runtime.ts"},{"name":"GrowthBubblesEngine.d.ts","path":"src/components/growth-bubbles/GrowthBubblesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GrowthBubbles } from \"solen-design/svelte\";\n</script>\n\n<GrowthBubbles />"}],"api":[{"name":"options","type":"GrowthBubblesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/growth-bubbles/SPEC.md","detail":"../../components/growth-bubbles.json"}