{"id":"spoiler-reveal","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SpoilerReveal.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSpoilerReveal, type SpoilerRevealOptions } from \"../../components/spoiler-reveal/SpoilerRevealEngine.js\";\nimport type { MotionController } from \"../../components/spoiler-reveal/motion-runtime\";\nexport let options: SpoilerRevealOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSpoilerReveal(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"spoiler-reveal\"></div>\n"}],"core":[{"name":"SpoilerRevealEngine.js","path":"src/components/spoiler-reveal/SpoilerRevealEngine.js"},{"name":"motion-runtime.ts","path":"src/components/spoiler-reveal/motion-runtime.ts"},{"name":"SpoilerRevealEngine.d.ts","path":"src/components/spoiler-reveal/SpoilerRevealEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SpoilerReveal } from \"solen-design/svelte\";\n</script>\n\n<SpoilerReveal />"}],"api":[{"name":"options","type":"SpoilerRevealOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/spoiler-reveal/SPEC.md","detail":"../../components/spoiler-reveal.json"}