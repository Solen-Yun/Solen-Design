{"id":"pixel-toggle","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PixelToggle.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPixelToggle, type PixelToggleOptions } from \"../../components/pixel-toggle/PixelToggleEngine.js\";\nimport type { MotionController } from \"../../components/pixel-toggle/motion-runtime\";\nexport let options: PixelToggleOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPixelToggle(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"pixel-toggle\"></div>\n"}],"core":[{"name":"PixelToggleEngine.js","path":"src/components/pixel-toggle/PixelToggleEngine.js"},{"name":"motion-runtime.ts","path":"src/components/pixel-toggle/motion-runtime.ts"},{"name":"PixelToggleEngine.d.ts","path":"src/components/pixel-toggle/PixelToggleEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PixelToggle } from \"solen-design/svelte\";\n</script>\n\n<PixelToggle options={{ checked: day, onCheckedChange: setDay }} />"}],"api":[{"name":"options","type":"PixelToggleOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/pixel-toggle/SPEC.md","detail":"../../components/pixel-toggle.json"}