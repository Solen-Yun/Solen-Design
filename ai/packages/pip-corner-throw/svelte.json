{"id":"pip-corner-throw","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PipCornerThrow.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPipCornerThrow, type PipCornerThrowOptions } from \"../../components/pip-corner-throw/PipCornerThrowEngine.js\";\nimport type { MotionController } from \"../../components/pip-corner-throw/motion-runtime\";\nexport let options: PipCornerThrowOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPipCornerThrow(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"pip-corner-throw\"></div>\n"}],"core":[{"name":"PipCornerThrowEngine.js","path":"src/components/pip-corner-throw/PipCornerThrowEngine.js"},{"name":"motion-runtime.ts","path":"src/components/pip-corner-throw/motion-runtime.ts"},{"name":"PipCornerThrowEngine.d.ts","path":"src/components/pip-corner-throw/PipCornerThrowEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PipCornerThrow } from \"solen-design/svelte\";\n</script>\n\n<PipCornerThrow />"}],"api":[{"name":"options","type":"PipCornerThrowOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/pip-corner-throw/SPEC.md","detail":"../../components/pip-corner-throw.json"}