{"id":"tile-flip-wave","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TileFlipWave.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTileFlipWave, type TileFlipWaveOptions } from \"../../components/tile-flip-wave/TileFlipWaveEngine.js\";\nimport type { MotionController } from \"../../components/tile-flip-wave/motion-runtime\";\nexport let options: TileFlipWaveOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTileFlipWave(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"tile-flip-wave\"></div>\n"}],"core":[{"name":"TileFlipWaveEngine.js","path":"src/components/tile-flip-wave/TileFlipWaveEngine.js"},{"name":"motion-runtime.ts","path":"src/components/tile-flip-wave/motion-runtime.ts"},{"name":"TileFlipWaveEngine.d.ts","path":"src/components/tile-flip-wave/TileFlipWaveEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TileFlipWave } from \"solen-design/svelte\";\n</script>\n\n<TileFlipWave />"}],"api":[{"name":"options","type":"TileFlipWaveOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/tile-flip-wave/SPEC.md","detail":"../../components/tile-flip-wave.json"}