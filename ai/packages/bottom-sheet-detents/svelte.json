{"id":"bottom-sheet-detents","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BottomSheetDetents.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBottomSheetDetents, type BottomSheetDetentsOptions } from \"../../components/bottom-sheet-detents/BottomSheetDetentsEngine.js\";\nimport type { MotionController } from \"../../components/bottom-sheet-detents/motion-runtime\";\nexport let options: BottomSheetDetentsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBottomSheetDetents(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"bottom-sheet-detents\"></div>\n"}],"core":[{"name":"BottomSheetDetentsEngine.js","path":"src/components/bottom-sheet-detents/BottomSheetDetentsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/bottom-sheet-detents/motion-runtime.ts"},{"name":"BottomSheetDetentsEngine.d.ts","path":"src/components/bottom-sheet-detents/BottomSheetDetentsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BottomSheetDetents } from \"solen-design/svelte\";\n</script>\n\n<BottomSheetDetents />"}],"api":[{"name":"options","type":"BottomSheetDetentsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/bottom-sheet-detents/SPEC.md","detail":"../../components/bottom-sheet-detents.json"}