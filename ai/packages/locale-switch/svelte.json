{"id":"locale-switch","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LocaleSwitch.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLocaleSwitch, type LocaleSwitchOptions } from \"../../components/locale-switch/LocaleSwitchEngine.js\";\nimport type { MotionController } from \"../../components/locale-switch/motion-runtime\";\nexport let options: LocaleSwitchOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLocaleSwitch(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"locale-switch\"></div>\n"}],"core":[{"name":"LocaleSwitchEngine.js","path":"src/components/locale-switch/LocaleSwitchEngine.js"},{"name":"motion-runtime.ts","path":"src/components/locale-switch/motion-runtime.ts"},{"name":"LocaleSwitchEngine.d.ts","path":"src/components/locale-switch/LocaleSwitchEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LocaleSwitch } from \"solen-design/svelte\";\n</script>\n\n<LocaleSwitch />"}],"api":[{"name":"options","type":"LocaleSwitchOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/locale-switch/SPEC.md","detail":"../../components/locale-switch.json"}