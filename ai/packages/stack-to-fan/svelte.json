{"id":"stack-to-fan","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StackToFan.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStackToFan, type StackToFanOptions } from \"../../components/stack-to-fan/StackToFanEngine.js\";\nimport type { MotionController } from \"../../components/stack-to-fan/motion-runtime\";\nexport let options: StackToFanOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStackToFan(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"stack-to-fan\"></div>\n"}],"core":[{"name":"StackToFanEngine.js","path":"src/components/stack-to-fan/StackToFanEngine.js"},{"name":"motion-runtime.ts","path":"src/components/stack-to-fan/motion-runtime.ts"},{"name":"StackToFanEngine.d.ts","path":"src/components/stack-to-fan/StackToFanEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StackToFan } from \"solen-design/svelte\";\n</script>\n\n<StackToFan />"}],"api":[{"name":"options","type":"StackToFanOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/stack-to-fan/SPEC.md","detail":"../../components/stack-to-fan.json"}