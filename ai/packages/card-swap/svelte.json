{"id":"card-swap","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CardSwap.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCardSwap, type CardSwapOptions } from \"../../components/card-swap/CardSwapEngine.js\";\nimport type { MotionController } from \"../../components/card-swap/motion-runtime\";\nexport let options: CardSwapOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCardSwap(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"card-swap\"></div>\n"}],"core":[{"name":"CardSwapEngine.js","path":"src/components/card-swap/CardSwapEngine.js"},{"name":"motion-runtime.ts","path":"src/components/card-swap/motion-runtime.ts"},{"name":"CardSwapEngine.d.ts","path":"src/components/card-swap/CardSwapEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CardSwap } from \"solen-design/svelte\";\n</script>\n\n<CardSwap />"}],"api":[{"name":"options","type":"CardSwapOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/card-swap/SPEC.md","detail":"../../components/card-swap.json"}