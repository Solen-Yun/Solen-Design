{"id":"stacked-metadata","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StackedMetadata.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStackedMetadata, type StackedMetadataOptions } from \"../../components/stacked-metadata/StackedMetadataEngine.js\";\nimport type { MotionController } from \"../../components/stacked-metadata/motion-runtime\";\nexport let options: StackedMetadataOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStackedMetadata(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"stacked-metadata\"></div>\n"}],"core":[{"name":"StackedMetadataEngine.js","path":"src/components/stacked-metadata/StackedMetadataEngine.js"},{"name":"motion-runtime.ts","path":"src/components/stacked-metadata/motion-runtime.ts"},{"name":"StackedMetadataEngine.d.ts","path":"src/components/stacked-metadata/StackedMetadataEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StackedMetadata } from \"solen-design/svelte\";\n</script>\n\n<StackedMetadata />"}],"api":[{"name":"options","type":"StackedMetadataOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/stacked-metadata/SPEC.md","detail":"../../components/stacked-metadata.json"}