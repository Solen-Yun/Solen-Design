{"id":"reveal-footer","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"RevealFooter.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountRevealFooter, type RevealFooterOptions } from \"../../components/reveal-footer/RevealFooterEngine.js\";\nimport type { MotionController } from \"../../components/reveal-footer/motion-runtime\";\nexport let options: RevealFooterOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountRevealFooter(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"reveal-footer\"></div>\n"}],"core":[{"name":"RevealFooterEngine.js","path":"src/components/reveal-footer/RevealFooterEngine.js"},{"name":"motion-runtime.ts","path":"src/components/reveal-footer/motion-runtime.ts"},{"name":"RevealFooterEngine.d.ts","path":"src/components/reveal-footer/RevealFooterEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { RevealFooter } from \"solen-design/svelte\";\n</script>\n\n<RevealFooter />"}],"api":[{"name":"options","type":"RevealFooterOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/reveal-footer/SPEC.md","detail":"../../components/reveal-footer.json"}