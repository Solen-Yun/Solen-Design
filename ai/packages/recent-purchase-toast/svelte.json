{"id":"recent-purchase-toast","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"RecentPurchaseToast.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountRecentPurchaseToast, type RecentPurchaseToastOptions } from \"../../components/recent-purchase-toast/RecentPurchaseToastEngine.js\";\nimport type { MotionController } from \"../../components/recent-purchase-toast/motion-runtime\";\nexport let options: RecentPurchaseToastOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountRecentPurchaseToast(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"recent-purchase-toast\"></div>\n"}],"core":[{"name":"RecentPurchaseToastEngine.js","path":"src/components/recent-purchase-toast/RecentPurchaseToastEngine.js"},{"name":"motion-runtime.ts","path":"src/components/recent-purchase-toast/motion-runtime.ts"},{"name":"RecentPurchaseToastEngine.d.ts","path":"src/components/recent-purchase-toast/RecentPurchaseToastEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { RecentPurchaseToast } from \"solen-design/svelte\";\n</script>\n\n<RecentPurchaseToast />"}],"api":[{"name":"options","type":"RecentPurchaseToastOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/recent-purchase-toast/SPEC.md","detail":"../../components/recent-purchase-toast.json"}