{"id":"terminal-demo","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TerminalDemo.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTerminalDemo, type TerminalDemoOptions } from \"../../components/terminal-demo/TerminalDemoEngine.js\";\nimport type { MotionController } from \"../../components/terminal-demo/motion-runtime\";\nexport let options: TerminalDemoOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTerminalDemo(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"terminal-demo\"></div>\n"}],"core":[{"name":"TerminalDemoEngine.js","path":"src/components/terminal-demo/TerminalDemoEngine.js"},{"name":"motion-runtime.ts","path":"src/components/terminal-demo/motion-runtime.ts"},{"name":"TerminalDemoEngine.d.ts","path":"src/components/terminal-demo/TerminalDemoEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TerminalDemo } from \"solen-design/svelte\";\n</script>\n\n<TerminalDemo />"}],"api":[{"name":"options","type":"TerminalDemoOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/terminal-demo/SPEC.md","detail":"../../components/terminal-demo.json"}