{"id":"reading-focus","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ReadingFocus.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountReadingFocus, type ReadingFocusOptions } from \"../../components/reading-focus/ReadingFocusEngine.js\";\nimport type { MotionController } from \"../../components/reading-focus/motion-runtime\";\nexport let options: ReadingFocusOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountReadingFocus(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"reading-focus\"></div>\n"}],"core":[{"name":"ReadingFocusEngine.js","path":"src/components/reading-focus/ReadingFocusEngine.js"},{"name":"motion-runtime.ts","path":"src/components/reading-focus/motion-runtime.ts"},{"name":"ReadingFocusEngine.d.ts","path":"src/components/reading-focus/ReadingFocusEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ReadingFocus } from \"solen-design/svelte\";\n</script>\n\n<ReadingFocus />"}],"api":[{"name":"options","type":"ReadingFocusOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/reading-focus/SPEC.md","detail":"../../components/reading-focus.json"}