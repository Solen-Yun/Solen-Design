{"id":"api-playground","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ApiPlayground.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountApiPlayground, type ApiPlaygroundOptions } from \"../../components/api-playground/ApiPlaygroundEngine.js\";\nimport type { MotionController } from \"../../components/api-playground/motion-runtime\";\nexport let options: ApiPlaygroundOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountApiPlayground(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"api-playground\"></div>\n"}],"core":[{"name":"ApiPlaygroundEngine.js","path":"src/components/api-playground/ApiPlaygroundEngine.js"},{"name":"motion-runtime.ts","path":"src/components/api-playground/motion-runtime.ts"},{"name":"ApiPlaygroundEngine.d.ts","path":"src/components/api-playground/ApiPlaygroundEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ApiPlayground } from \"solen-design/svelte\";\n</script>\n\n<ApiPlayground />"}],"api":[{"name":"options","type":"ApiPlaygroundOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/api-playground/SPEC.md","detail":"../../components/api-playground.json"}