{"id":"scroll-expand-video","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ScrollExpandVideo.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountScrollExpandVideo, type ScrollExpandVideoOptions } from \"../../components/scroll-expand-video/ScrollExpandVideoEngine.js\";\nimport type { MotionController } from \"../../components/scroll-expand-video/motion-runtime\";\nexport let options: ScrollExpandVideoOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountScrollExpandVideo(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"scroll-expand-video\"></div>\n"}],"core":[{"name":"ScrollExpandVideoEngine.js","path":"src/components/scroll-expand-video/ScrollExpandVideoEngine.js"},{"name":"motion-runtime.ts","path":"src/components/scroll-expand-video/motion-runtime.ts"},{"name":"ScrollExpandVideoEngine.d.ts","path":"src/components/scroll-expand-video/ScrollExpandVideoEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ScrollExpandVideo } from \"solen-design/svelte\";\n</script>\n\n<ScrollExpandVideo />"}],"api":[{"name":"options","type":"ScrollExpandVideoOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/scroll-expand-video/SPEC.md","detail":"../../components/scroll-expand-video.json"}