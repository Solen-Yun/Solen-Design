{"id":"sticky-phone-screens","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StickyPhoneScreens.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStickyPhoneScreens, type StickyPhoneScreensOptions } from \"../../components/sticky-phone-screens/StickyPhoneScreensEngine.js\";\nimport type { MotionController } from \"../../components/sticky-phone-screens/motion-runtime\";\nexport let options: StickyPhoneScreensOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStickyPhoneScreens(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"sticky-phone-screens\"></div>\n"}],"core":[{"name":"StickyPhoneScreensEngine.js","path":"src/components/sticky-phone-screens/StickyPhoneScreensEngine.js"},{"name":"motion-runtime.ts","path":"src/components/sticky-phone-screens/motion-runtime.ts"},{"name":"StickyPhoneScreensEngine.d.ts","path":"src/components/sticky-phone-screens/StickyPhoneScreensEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StickyPhoneScreens } from \"solen-design/svelte\";\n</script>\n\n<StickyPhoneScreens />"}],"api":[{"name":"options","type":"StickyPhoneScreensOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/sticky-phone-screens/SPEC.md","detail":"../../components/sticky-phone-screens.json"}