{"id":"marker-highlight","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MarkerHighlight.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMarkerHighlight, type MarkerHighlightOptions } from \"../../components/marker-highlight/MarkerHighlightEngine.js\";\nimport type { MotionController } from \"../../components/marker-highlight/motion-runtime\";\nexport let options: MarkerHighlightOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMarkerHighlight(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"marker-highlight\"></div>\n"}],"core":[{"name":"MarkerHighlightEngine.js","path":"src/components/marker-highlight/MarkerHighlightEngine.js"},{"name":"motion-runtime.ts","path":"src/components/marker-highlight/motion-runtime.ts"},{"name":"MarkerHighlightEngine.d.ts","path":"src/components/marker-highlight/MarkerHighlightEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MarkerHighlight } from \"solen-design/svelte\";\n</script>\n\n<MarkerHighlight />"}],"api":[{"name":"options","type":"MarkerHighlightOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/marker-highlight/SPEC.md","detail":"../../components/marker-highlight.json"}