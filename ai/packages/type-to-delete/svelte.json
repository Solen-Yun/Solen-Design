{"id":"type-to-delete","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TypeToDelete.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTypeToDelete, type TypeToDeleteOptions } from \"../../components/type-to-delete/TypeToDeleteEngine.js\";\nimport type { MotionController } from \"../../components/type-to-delete/motion-runtime\";\nexport let options: TypeToDeleteOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTypeToDelete(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"type-to-delete\"></div>\n"}],"core":[{"name":"TypeToDeleteEngine.js","path":"src/components/type-to-delete/TypeToDeleteEngine.js"},{"name":"motion-runtime.ts","path":"src/components/type-to-delete/motion-runtime.ts"},{"name":"TypeToDeleteEngine.d.ts","path":"src/components/type-to-delete/TypeToDeleteEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TypeToDelete } from \"solen-design/svelte\";\n</script>\n\n<TypeToDelete />"}],"api":[{"name":"options","type":"TypeToDeleteOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/type-to-delete/SPEC.md","detail":"../../components/type-to-delete.json"}