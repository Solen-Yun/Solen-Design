{"id":"chord-diagram","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ChordDiagram.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountChordDiagram, type ChordDiagramOptions } from \"../../components/chord-diagram/ChordDiagramEngine.js\";\nimport type { MotionController } from \"../../components/chord-diagram/motion-runtime\";\nexport let options: ChordDiagramOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountChordDiagram(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"chord-diagram\"></div>\n"}],"core":[{"name":"ChordDiagramEngine.js","path":"src/components/chord-diagram/ChordDiagramEngine.js"},{"name":"motion-runtime.ts","path":"src/components/chord-diagram/motion-runtime.ts"},{"name":"ChordDiagramEngine.d.ts","path":"src/components/chord-diagram/ChordDiagramEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ChordDiagram } from \"solen-design/svelte\";\n</script>\n\n<ChordDiagram />"}],"api":[{"name":"options","type":"ChordDiagramOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/chord-diagram/SPEC.md","detail":"../../components/chord-diagram.json"}