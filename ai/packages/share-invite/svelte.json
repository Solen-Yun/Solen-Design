{"id":"share-invite","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ShareInvite.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountShareInvite, type ShareInviteOptions } from \"../../components/share-invite/ShareInviteEngine.js\";\nimport type { MotionController } from \"../../components/share-invite/motion-runtime\";\nexport let options: ShareInviteOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountShareInvite(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"share-invite\"></div>\n"}],"core":[{"name":"ShareInviteEngine.js","path":"src/components/share-invite/ShareInviteEngine.js"},{"name":"share-motion.js","path":"src/components/share-invite/share-motion.js"},{"name":"motion-runtime.ts","path":"src/components/share-invite/motion-runtime.ts"},{"name":"ShareInviteEngine.d.ts","path":"src/components/share-invite/ShareInviteEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ShareInvite } from \"solen-design/svelte\";\n</script>\n\n<ShareInvite />"}],"api":[{"name":"options","type":"ShareInviteOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/share-invite/SPEC.md","detail":"../../components/share-invite.json"}