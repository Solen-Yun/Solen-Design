{"id":"line-mask-reveal","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LineMaskReveal.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLineMaskReveal, type LineMaskRevealOptions } from \"../../components/line-mask-reveal/LineMaskRevealEngine.js\";\nimport type { MotionController } from \"../../components/line-mask-reveal/motion-runtime\";\nexport let options: LineMaskRevealOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLineMaskReveal(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"line-mask-reveal\"></div>\n"}],"core":[{"name":"LineMaskRevealEngine.js","path":"src/components/line-mask-reveal/LineMaskRevealEngine.js"},{"name":"motion-runtime.ts","path":"src/components/line-mask-reveal/motion-runtime.ts"},{"name":"LineMaskRevealEngine.d.ts","path":"src/components/line-mask-reveal/LineMaskRevealEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LineMaskReveal } from \"solen-design/svelte\";\n</script>\n\n<LineMaskReveal />"}],"api":[{"name":"options","type":"LineMaskRevealOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/line-mask-reveal/SPEC.md","detail":"../../components/line-mask-reveal.json"}