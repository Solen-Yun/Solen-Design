{"id":"keyhole-zoom","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"KeyholeZoom.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountKeyholeZoom, type KeyholeZoomOptions } from \"../../components/keyhole-zoom/KeyholeZoomEngine.js\";\nimport type { MotionController } from \"../../components/keyhole-zoom/motion-runtime\";\nexport let options: KeyholeZoomOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountKeyholeZoom(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"keyhole-zoom\"></div>\n"}],"core":[{"name":"KeyholeZoomEngine.js","path":"src/components/keyhole-zoom/KeyholeZoomEngine.js"},{"name":"motion-runtime.ts","path":"src/components/keyhole-zoom/motion-runtime.ts"},{"name":"KeyholeZoomEngine.d.ts","path":"src/components/keyhole-zoom/KeyholeZoomEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { KeyholeZoom } from \"solen-design/svelte\";\n</script>\n\n<KeyholeZoom />"}],"api":[{"name":"options","type":"KeyholeZoomOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/keyhole-zoom/SPEC.md","detail":"../../components/keyhole-zoom.json"}