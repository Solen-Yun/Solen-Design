{"id":"horizontal-pin-track","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"HorizontalPinTrack.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountHorizontalPinTrack, type HorizontalPinTrackOptions } from \"../../components/horizontal-pin-track/HorizontalPinTrackEngine.js\";\nimport type { MotionController } from \"../../components/horizontal-pin-track/motion-runtime\";\nexport let options: HorizontalPinTrackOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountHorizontalPinTrack(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"horizontal-pin-track\"></div>\n"}],"core":[{"name":"HorizontalPinTrackEngine.js","path":"src/components/horizontal-pin-track/HorizontalPinTrackEngine.js"},{"name":"motion-runtime.ts","path":"src/components/horizontal-pin-track/motion-runtime.ts"},{"name":"HorizontalPinTrackEngine.d.ts","path":"src/components/horizontal-pin-track/HorizontalPinTrackEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { HorizontalPinTrack } from \"solen-design/svelte\";\n</script>\n\n<HorizontalPinTrack />"}],"api":[{"name":"options","type":"HorizontalPinTrackOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/horizontal-pin-track/SPEC.md","detail":"../../components/horizontal-pin-track.json"}