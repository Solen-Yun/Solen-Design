{"id":"brand-line-cards","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BrandLineCards.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBrandLineCards, type BrandLineCardsOptions } from \"../../components/brand-line-cards/BrandLineCardsEngine.js\";\nimport type { MotionController } from \"../../components/brand-line-cards/motion-runtime\";\nexport let options: BrandLineCardsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBrandLineCards(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"brand-line-cards\"></div>\n"}],"core":[{"name":"BrandLineCardsEngine.js","path":"src/components/brand-line-cards/BrandLineCardsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/brand-line-cards/motion-runtime.ts"},{"name":"BrandLineCardsEngine.d.ts","path":"src/components/brand-line-cards/BrandLineCardsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BrandLineCards } from \"solen-design/svelte\";\n</script>\n\n<BrandLineCards />"}],"api":[{"name":"options","type":"BrandLineCardsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/brand-line-cards/SPEC.md","detail":"../../components/brand-line-cards.json"}