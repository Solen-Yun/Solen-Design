{"id":"slope-chart","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SlopeChart.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSlopeChart, type SlopeChartOptions } from \"../../components/slope-chart/SlopeChartEngine.js\";\nimport type { MotionController } from \"../../components/slope-chart/motion-runtime\";\nexport let options: SlopeChartOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSlopeChart(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"slope-chart\"></div>\n"}],"core":[{"name":"SlopeChartEngine.js","path":"src/components/slope-chart/SlopeChartEngine.js"},{"name":"motion-runtime.ts","path":"src/components/slope-chart/motion-runtime.ts"},{"name":"SlopeChartEngine.d.ts","path":"src/components/slope-chart/SlopeChartEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SlopeChart } from \"solen-design/svelte\";\n</script>\n\n<SlopeChart />"}],"api":[{"name":"options","type":"SlopeChartOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/slope-chart/SPEC.md","detail":"../../components/slope-chart.json"}