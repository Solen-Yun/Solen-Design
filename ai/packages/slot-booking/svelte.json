{"id":"slot-booking","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SlotBooking.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSlotBooking, type SlotBookingOptions } from \"../../components/slot-booking/SlotBookingEngine.js\";\nimport type { MotionController } from \"../../components/slot-booking/motion-runtime\";\nexport let options: SlotBookingOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSlotBooking(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"slot-booking\"></div>\n"}],"core":[{"name":"SlotBookingEngine.js","path":"src/components/slot-booking/SlotBookingEngine.js"},{"name":"motion-runtime.ts","path":"src/components/slot-booking/motion-runtime.ts"},{"name":"SlotBookingEngine.d.ts","path":"src/components/slot-booking/SlotBookingEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SlotBooking } from \"solen-design/svelte\";\n</script>\n\n<SlotBooking />"}],"api":[{"name":"options","type":"SlotBookingOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/slot-booking/SPEC.md","detail":"../../components/slot-booking.json"}