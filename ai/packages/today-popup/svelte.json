{"id":"today-popup","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TodayPopup.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTodayPopup, type TodayPopupOptions } from \"../../components/today-popup/TodayPopupEngine.js\";\nimport type { MotionController } from \"../../components/today-popup/motion-runtime\";\nexport let options: TodayPopupOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTodayPopup(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"today-popup\"></div>\n"}],"core":[{"name":"TodayPopupEngine.js","path":"src/components/today-popup/TodayPopupEngine.js"},{"name":"motion-runtime.ts","path":"src/components/today-popup/motion-runtime.ts"},{"name":"TodayPopupEngine.d.ts","path":"src/components/today-popup/TodayPopupEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TodayPopup } from \"solen-design/svelte\";\n</script>\n\n<TodayPopup />"}],"api":[{"name":"options","type":"TodayPopupOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/today-popup/SPEC.md","detail":"../../components/today-popup.json"}