{"id":"phone-country-input","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PhoneCountryInput.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPhoneCountryInput, type PhoneCountryInputOptions } from \"../../components/phone-country-input/PhoneCountryInputEngine.js\";\nimport type { MotionController } from \"../../components/phone-country-input/motion-runtime\";\nexport let options: PhoneCountryInputOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPhoneCountryInput(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"phone-country-input\"></div>\n"}],"core":[{"name":"PhoneCountryInputEngine.js","path":"src/components/phone-country-input/PhoneCountryInputEngine.js"},{"name":"motion-runtime.ts","path":"src/components/phone-country-input/motion-runtime.ts"},{"name":"PhoneCountryInputEngine.d.ts","path":"src/components/phone-country-input/PhoneCountryInputEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PhoneCountryInput } from \"solen-design/svelte\";\n</script>\n\n<PhoneCountryInput />"}],"api":[{"name":"options","type":"PhoneCountryInputOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/phone-country-input/SPEC.md","detail":"../../components/phone-country-input.json"}