{"id":"changelog-filter","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ChangelogFilter.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountChangelogFilter, type ChangelogFilterOptions } from \"../../components/changelog-filter/ChangelogFilterEngine.js\";\nimport type { MotionController } from \"../../components/changelog-filter/motion-runtime\";\nexport let options: ChangelogFilterOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountChangelogFilter(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"changelog-filter\"></div>\n"}],"core":[{"name":"ChangelogFilterEngine.js","path":"src/components/changelog-filter/ChangelogFilterEngine.js"},{"name":"motion-runtime.ts","path":"src/components/changelog-filter/motion-runtime.ts"},{"name":"ChangelogFilterEngine.d.ts","path":"src/components/changelog-filter/ChangelogFilterEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ChangelogFilter } from \"solen-design/svelte\";\n</script>\n\n<ChangelogFilter />"}],"api":[{"name":"options","type":"ChangelogFilterOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/changelog-filter/SPEC.md","detail":"../../components/changelog-filter.json"}