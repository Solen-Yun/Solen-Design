{"id":"population-pyramid","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PopulationPyramid.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPopulationPyramid, type PopulationPyramidOptions } from \"../../components/population-pyramid/PopulationPyramidEngine.js\";\nimport type { MotionController } from \"../../components/population-pyramid/motion-runtime\";\nexport let options: PopulationPyramidOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPopulationPyramid(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"population-pyramid\"></div>\n"}],"core":[{"name":"PopulationPyramidEngine.js","path":"src/components/population-pyramid/PopulationPyramidEngine.js"},{"name":"motion-runtime.ts","path":"src/components/population-pyramid/motion-runtime.ts"},{"name":"PopulationPyramidEngine.d.ts","path":"src/components/population-pyramid/PopulationPyramidEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PopulationPyramid } from \"solen-design/svelte\";\n</script>\n\n<PopulationPyramid />"}],"api":[{"name":"options","type":"PopulationPyramidOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/population-pyramid/SPEC.md","detail":"../../components/population-pyramid.json"}