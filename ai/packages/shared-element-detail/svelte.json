{"id":"shared-element-detail","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SharedElementDetail.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSharedElementDetail, type SharedElementDetailOptions } from \"../../components/shared-element-detail/SharedElementDetailEngine.js\";\nimport type { MotionController } from \"../../components/shared-element-detail/motion-runtime\";\nexport let options: SharedElementDetailOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSharedElementDetail(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"shared-element-detail\"></div>\n"}],"core":[{"name":"SharedElementDetailEngine.js","path":"src/components/shared-element-detail/SharedElementDetailEngine.js"},{"name":"motion-runtime.ts","path":"src/components/shared-element-detail/motion-runtime.ts"},{"name":"SharedElementDetailEngine.d.ts","path":"src/components/shared-element-detail/SharedElementDetailEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SharedElementDetail } from \"solen-design/svelte\";\n</script>\n\n<SharedElementDetail />"}],"api":[{"name":"options","type":"SharedElementDetailOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/shared-element-detail/SPEC.md","detail":"../../components/shared-element-detail.json"}