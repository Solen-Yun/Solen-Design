{"id":"padlock-toggle","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PadlockToggle.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPadlockToggle, type PadlockToggleOptions } from \"../../components/padlock-toggle/PadlockToggleEngine.js\";\nimport type { MotionController } from \"../../components/padlock-toggle/motion-runtime\";\nexport let options: PadlockToggleOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPadlockToggle(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"padlock-toggle\"></div>\n"}],"core":[{"name":"PadlockToggleEngine.js","path":"src/components/padlock-toggle/PadlockToggleEngine.js"},{"name":"motion-runtime.ts","path":"src/components/padlock-toggle/motion-runtime.ts"},{"name":"PadlockToggleEngine.d.ts","path":"src/components/padlock-toggle/PadlockToggleEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PadlockToggle } from \"solen-design/svelte\";\n</script>\n\n<PadlockToggle />"}],"api":[{"name":"options","type":"PadlockToggleOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/padlock-toggle/SPEC.md","detail":"../../components/padlock-toggle.json"}