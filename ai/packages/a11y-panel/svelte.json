{"id":"a11y-panel","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"A11yPanel.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountA11yPanel, type A11yPanelOptions } from \"../../components/a11y-panel/A11yPanelEngine.js\";\nimport type { MotionController } from \"../../components/a11y-panel/motion-runtime\";\nexport let options: A11yPanelOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountA11yPanel(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"a11y-panel\"></div>\n"}],"core":[{"name":"A11yPanelEngine.js","path":"src/components/a11y-panel/A11yPanelEngine.js"},{"name":"motion-runtime.ts","path":"src/components/a11y-panel/motion-runtime.ts"},{"name":"A11yPanelEngine.d.ts","path":"src/components/a11y-panel/A11yPanelEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { A11yPanel } from \"solen-design/svelte\";\n</script>\n\n<A11yPanel />"}],"api":[{"name":"options","type":"A11yPanelOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/a11y-panel/SPEC.md","detail":"../../components/a11y-panel.json"}