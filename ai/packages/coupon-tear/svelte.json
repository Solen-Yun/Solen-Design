{"id":"coupon-tear","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CouponTear.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCouponTear, type CouponTearOptions } from \"../../components/coupon-tear/CouponTearEngine.js\";\nimport type { MotionController } from \"../../components/coupon-tear/motion-runtime\";\nexport let options: CouponTearOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCouponTear(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"coupon-tear\"></div>\n"}],"core":[{"name":"CouponTearEngine.js","path":"src/components/coupon-tear/CouponTearEngine.js"},{"name":"motion-runtime.ts","path":"src/components/coupon-tear/motion-runtime.ts"},{"name":"CouponTearEngine.d.ts","path":"src/components/coupon-tear/CouponTearEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CouponTear } from \"solen-design/svelte\";\n</script>\n\n<CouponTear />"}],"api":[{"name":"options","type":"CouponTearOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/coupon-tear/SPEC.md","detail":"../../components/coupon-tear.json"}