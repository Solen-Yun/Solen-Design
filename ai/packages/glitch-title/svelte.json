{"id":"glitch-title","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GlitchTitle.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGlitchTitle, type GlitchTitleOptions } from \"../../components/glitch-title/GlitchTitleEngine.js\";\nimport type { MotionController } from \"../../components/glitch-title/motion-runtime\";\nexport let options: GlitchTitleOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGlitchTitle(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"glitch-title\"></div>\n"}],"core":[{"name":"GlitchTitleEngine.js","path":"src/components/glitch-title/GlitchTitleEngine.js"},{"name":"motion-runtime.ts","path":"src/components/glitch-title/motion-runtime.ts"},{"name":"GlitchTitleEngine.d.ts","path":"src/components/glitch-title/GlitchTitleEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GlitchTitle } from \"solen-design/svelte\";\n</script>\n\n<GlitchTitle />"}],"api":[{"name":"options","type":"GlitchTitleOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/glitch-title/SPEC.md","detail":"../../components/glitch-title.json"}