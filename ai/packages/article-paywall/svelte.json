{"id":"article-paywall","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ArticlePaywall.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountArticlePaywall, type ArticlePaywallOptions } from \"../../components/article-paywall/ArticlePaywallEngine.js\";\nimport type { MotionController } from \"../../components/article-paywall/motion-runtime\";\nexport let options: ArticlePaywallOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountArticlePaywall(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"article-paywall\"></div>\n"}],"core":[{"name":"ArticlePaywallEngine.js","path":"src/components/article-paywall/ArticlePaywallEngine.js"},{"name":"motion-runtime.ts","path":"src/components/article-paywall/motion-runtime.ts"},{"name":"ArticlePaywallEngine.d.ts","path":"src/components/article-paywall/ArticlePaywallEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ArticlePaywall } from \"solen-design/svelte\";\n</script>\n\n<ArticlePaywall />"}],"api":[{"name":"options","type":"ArticlePaywallOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/article-paywall/SPEC.md","detail":"../../components/article-paywall.json"}