{"id":"stamp-card","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StampCard.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStampCard, type StampCardOptions } from \"../../components/stamp-card/StampCardEngine.js\";\nimport type { MotionController } from \"../../components/stamp-card/motion-runtime\";\nexport let options: StampCardOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStampCard(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"stamp-card\"></div>\n"}],"core":[{"name":"StampCardEngine.js","path":"src/components/stamp-card/StampCardEngine.js"},{"name":"motion-runtime.ts","path":"src/components/stamp-card/motion-runtime.ts"},{"name":"StampCardEngine.d.ts","path":"src/components/stamp-card/StampCardEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StampCard } from \"solen-design/svelte\";\n</script>\n\n<StampCard />"}],"api":[{"name":"options","type":"StampCardOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/stamp-card/SPEC.md","detail":"../../components/stamp-card.json"}