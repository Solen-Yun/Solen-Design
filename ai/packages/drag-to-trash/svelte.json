{"id":"drag-to-trash","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DragToTrash.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDragToTrash, type DragToTrashOptions } from \"../../components/drag-to-trash/DragToTrashEngine.js\";\nimport type { MotionController } from \"../../components/drag-to-trash/motion-runtime\";\nexport let options: DragToTrashOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDragToTrash(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"drag-to-trash\"></div>\n"}],"core":[{"name":"DragToTrashEngine.js","path":"src/components/drag-to-trash/DragToTrashEngine.js"},{"name":"motion-runtime.ts","path":"src/components/drag-to-trash/motion-runtime.ts"},{"name":"DragToTrashEngine.d.ts","path":"src/components/drag-to-trash/DragToTrashEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DragToTrash } from \"solen-design/svelte\";\n</script>\n\n<DragToTrash />"}],"api":[{"name":"options","type":"DragToTrashOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/drag-to-trash/SPEC.md","detail":"../../components/drag-to-trash.json"}