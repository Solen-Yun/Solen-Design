{"id":"clip-reveal-photos","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ClipRevealPhotos.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountClipRevealPhotos, type ClipRevealPhotosOptions } from \"../../components/clip-reveal-photos/ClipRevealPhotosEngine.js\";\nimport type { MotionController } from \"../../components/clip-reveal-photos/motion-runtime\";\nexport let options: ClipRevealPhotosOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountClipRevealPhotos(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"clip-reveal-photos\"></div>\n"}],"core":[{"name":"ClipRevealPhotosEngine.js","path":"src/components/clip-reveal-photos/ClipRevealPhotosEngine.js"},{"name":"motion-runtime.ts","path":"src/components/clip-reveal-photos/motion-runtime.ts"},{"name":"ClipRevealPhotosEngine.d.ts","path":"src/components/clip-reveal-photos/ClipRevealPhotosEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ClipRevealPhotos } from \"solen-design/svelte\";\n</script>\n\n<ClipRevealPhotos />"}],"api":[{"name":"options","type":"ClipRevealPhotosOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/clip-reveal-photos/SPEC.md","detail":"../../components/clip-reveal-photos.json"}