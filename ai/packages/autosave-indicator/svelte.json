{"id":"autosave-indicator","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AutosaveIndicator.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAutosaveIndicator, type AutosaveIndicatorOptions } from \"../../components/autosave-indicator/AutosaveIndicatorEngine.js\";\nimport type { MotionController } from \"../../components/autosave-indicator/motion-runtime\";\nexport let options: AutosaveIndicatorOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAutosaveIndicator(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"autosave-indicator\"></div>\n"}],"core":[{"name":"AutosaveIndicatorEngine.js","path":"src/components/autosave-indicator/AutosaveIndicatorEngine.js"},{"name":"motion-runtime.ts","path":"src/components/autosave-indicator/motion-runtime.ts"},{"name":"AutosaveIndicatorEngine.d.ts","path":"src/components/autosave-indicator/AutosaveIndicatorEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AutosaveIndicator } from \"solen-design/svelte\";\n</script>\n\n<AutosaveIndicator />"}],"api":[{"name":"options","type":"AutosaveIndicatorOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/autosave-indicator/SPEC.md","detail":"../../components/autosave-indicator.json"}