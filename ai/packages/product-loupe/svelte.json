{"id":"product-loupe","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ProductLoupe.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountProductLoupe, type ProductLoupeOptions } from \"../../components/product-loupe/ProductLoupeEngine.js\";\nimport type { MotionController } from \"../../components/product-loupe/motion-runtime\";\nexport let options: ProductLoupeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountProductLoupe(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"product-loupe\"></div>\n"}],"core":[{"name":"ProductLoupeEngine.js","path":"src/components/product-loupe/ProductLoupeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/product-loupe/motion-runtime.ts"},{"name":"ProductLoupeEngine.d.ts","path":"src/components/product-loupe/ProductLoupeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ProductLoupe } from \"solen-design/svelte\";\n</script>\n\n<ProductLoupe />"}],"api":[{"name":"options","type":"ProductLoupeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/product-loupe/SPEC.md","detail":"../../components/product-loupe.json"}