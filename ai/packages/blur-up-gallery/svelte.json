{"id":"blur-up-gallery","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BlurUpGallery.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBlurUpGallery, type BlurUpGalleryOptions } from \"../../components/blur-up-gallery/BlurUpGalleryEngine.js\";\nimport type { MotionController } from \"../../components/blur-up-gallery/motion-runtime\";\nexport let options: BlurUpGalleryOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBlurUpGallery(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"blur-up-gallery\"></div>\n"}],"core":[{"name":"BlurUpGalleryEngine.js","path":"src/components/blur-up-gallery/BlurUpGalleryEngine.js"},{"name":"motion-runtime.ts","path":"src/components/blur-up-gallery/motion-runtime.ts"},{"name":"BlurUpGalleryEngine.d.ts","path":"src/components/blur-up-gallery/BlurUpGalleryEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BlurUpGallery } from \"solen-design/svelte\";\n</script>\n\n<BlurUpGallery />"}],"api":[{"name":"options","type":"BlurUpGalleryOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/blur-up-gallery/SPEC.md","detail":"../../components/blur-up-gallery.json"}