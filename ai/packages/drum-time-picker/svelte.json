{"id":"drum-time-picker","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DrumTimePicker.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDrumTimePicker, type DrumTimePickerOptions } from \"../../components/drum-time-picker/DrumTimePickerEngine.js\";\nimport type { MotionController } from \"../../components/drum-time-picker/motion-runtime\";\nexport let options: DrumTimePickerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDrumTimePicker(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"drum-time-picker\"></div>\n"}],"core":[{"name":"DrumTimePickerEngine.js","path":"src/components/drum-time-picker/DrumTimePickerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/drum-time-picker/motion-runtime.ts"},{"name":"DrumTimePickerEngine.d.ts","path":"src/components/drum-time-picker/DrumTimePickerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DrumTimePicker } from \"solen-design/svelte\";\n</script>\n\n<DrumTimePicker />"}],"api":[{"name":"options","type":"DrumTimePickerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/drum-time-picker/SPEC.md","detail":"../../components/drum-time-picker.json"}