{"id":"magnify-dock","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MagnifyDock.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMagnifyDock, type MagnifyDockOptions } from \"../../components/magnify-dock/MagnifyDockEngine.js\";\nimport type { MotionController } from \"../../components/magnify-dock/motion-runtime\";\nexport let options: MagnifyDockOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMagnifyDock(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"magnify-dock\"></div>\n"}],"core":[{"name":"MagnifyDockEngine.js","path":"src/components/magnify-dock/MagnifyDockEngine.js"},{"name":"motion-runtime.ts","path":"src/components/magnify-dock/motion-runtime.ts"},{"name":"MagnifyDockEngine.d.ts","path":"src/components/magnify-dock/MagnifyDockEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MagnifyDock } from \"solen-design/svelte\";\n</script>\n\n<MagnifyDock />"}],"api":[{"name":"options","type":"MagnifyDockOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/magnify-dock/SPEC.md","detail":"../../components/magnify-dock.json"}