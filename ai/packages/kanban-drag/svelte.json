{"id":"kanban-drag","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"KanbanDrag.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountKanbanDrag, type KanbanDragOptions } from \"../../components/kanban-drag/KanbanDragEngine.js\";\nimport type { MotionController } from \"../../components/kanban-drag/motion-runtime\";\nexport let options: KanbanDragOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountKanbanDrag(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"kanban-drag\"></div>\n"}],"core":[{"name":"KanbanDragEngine.js","path":"src/components/kanban-drag/KanbanDragEngine.js"},{"name":"motion-runtime.ts","path":"src/components/kanban-drag/motion-runtime.ts"},{"name":"KanbanDragEngine.d.ts","path":"src/components/kanban-drag/KanbanDragEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { KanbanDrag } from \"solen-design/svelte\";\n</script>\n\n<KanbanDrag />"}],"api":[{"name":"options","type":"KanbanDragOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/kanban-drag/SPEC.md","detail":"../../components/kanban-drag.json"}