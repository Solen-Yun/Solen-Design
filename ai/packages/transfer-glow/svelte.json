{"id":"transfer-glow","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TransferGlow.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTransferGlow, type TransferGlowOptions } from \"../../components/transfer-glow/TransferGlowEngine.js\";\nimport type { MotionController } from \"../../components/transfer-glow/motion-runtime\";\nexport let options: TransferGlowOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTransferGlow(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"transfer-glow\"></div>\n"}],"core":[{"name":"TransferGlowEngine.js","path":"src/components/transfer-glow/TransferGlowEngine.js"},{"name":"motion-runtime.ts","path":"src/components/transfer-glow/motion-runtime.ts"},{"name":"TransferGlowEngine.d.ts","path":"src/components/transfer-glow/TransferGlowEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TransferGlow } from \"solen-design/svelte\";\n</script>\n\n<TransferGlow />"}],"api":[{"name":"options","type":"TransferGlowOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/transfer-glow/SPEC.md","detail":"../../components/transfer-glow.json"}