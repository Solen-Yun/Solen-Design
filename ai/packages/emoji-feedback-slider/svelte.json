{"id":"emoji-feedback-slider","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"EmojiFeedbackSlider.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountEmojiFeedbackSlider, type EmojiFeedbackSliderOptions } from \"../../components/emoji-feedback-slider/EmojiFeedbackSliderEngine.js\";\nimport type { MotionController } from \"../../components/emoji-feedback-slider/motion-runtime\";\nexport let options: EmojiFeedbackSliderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountEmojiFeedbackSlider(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"emoji-feedback-slider\"></div>\n"}],"core":[{"name":"EmojiFeedbackSliderEngine.js","path":"src/components/emoji-feedback-slider/EmojiFeedbackSliderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/emoji-feedback-slider/motion-runtime.ts"},{"name":"EmojiFeedbackSliderEngine.d.ts","path":"src/components/emoji-feedback-slider/EmojiFeedbackSliderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { EmojiFeedbackSlider } from \"solen-design/svelte\";\n</script>\n\n<EmojiFeedbackSlider />"}],"api":[{"name":"options","type":"EmojiFeedbackSliderOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/emoji-feedback-slider/SPEC.md","detail":"../../components/emoji-feedback-slider.json"}