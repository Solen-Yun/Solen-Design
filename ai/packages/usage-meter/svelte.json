{"id":"usage-meter","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"UsageMeter.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountUsageMeter, type UsageMeterOptions } from \"../../components/usage-meter/UsageMeterEngine.js\";\nimport type { MotionController } from \"../../components/usage-meter/motion-runtime\";\nexport let options: UsageMeterOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountUsageMeter(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"usage-meter\"></div>\n"}],"core":[{"name":"UsageMeterEngine.js","path":"src/components/usage-meter/UsageMeterEngine.js"},{"name":"motion-runtime.ts","path":"src/components/usage-meter/motion-runtime.ts"},{"name":"UsageMeterEngine.d.ts","path":"src/components/usage-meter/UsageMeterEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { UsageMeter } from \"solen-design/svelte\";\n</script>\n\n<UsageMeter />"}],"api":[{"name":"options","type":"UsageMeterOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/usage-meter/SPEC.md","detail":"../../components/usage-meter.json"}