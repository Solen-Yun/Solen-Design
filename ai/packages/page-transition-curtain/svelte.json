{"id":"page-transition-curtain","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PageTransitionCurtain.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPageTransitionCurtain, type PageTransitionCurtainOptions } from \"../../components/page-transition-curtain/PageTransitionCurtainEngine.js\";\nimport type { MotionController } from \"../../components/page-transition-curtain/motion-runtime\";\nexport let options: PageTransitionCurtainOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPageTransitionCurtain(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"page-transition-curtain\"></div>\n"}],"core":[{"name":"PageTransitionCurtainEngine.js","path":"src/components/page-transition-curtain/PageTransitionCurtainEngine.js"},{"name":"motion-runtime.ts","path":"src/components/page-transition-curtain/motion-runtime.ts"},{"name":"PageTransitionCurtainEngine.d.ts","path":"src/components/page-transition-curtain/PageTransitionCurtainEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PageTransitionCurtain } from \"solen-design/svelte\";\n</script>\n\n<PageTransitionCurtain />"}],"api":[{"name":"options","type":"PageTransitionCurtainOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/page-transition-curtain/SPEC.md","detail":"../../components/page-transition-curtain.json"}