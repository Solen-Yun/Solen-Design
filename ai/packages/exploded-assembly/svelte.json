{"id":"exploded-assembly","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ExplodedAssembly.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountExplodedAssembly, type ExplodedAssemblyOptions } from \"../../components/exploded-assembly/ExplodedAssemblyEngine.js\";\nimport type { MotionController } from \"../../components/exploded-assembly/motion-runtime\";\nexport let options: ExplodedAssemblyOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountExplodedAssembly(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"exploded-assembly\"></div>\n"}],"core":[{"name":"ExplodedAssemblyEngine.js","path":"src/components/exploded-assembly/ExplodedAssemblyEngine.js"},{"name":"motion-runtime.ts","path":"src/components/exploded-assembly/motion-runtime.ts"},{"name":"ExplodedAssemblyEngine.d.ts","path":"src/components/exploded-assembly/ExplodedAssemblyEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ExplodedAssembly } from \"solen-design/svelte\";\n</script>\n\n<ExplodedAssembly />"}],"api":[{"name":"options","type":"ExplodedAssemblyOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/exploded-assembly/SPEC.md","detail":"../../components/exploded-assembly.json"}