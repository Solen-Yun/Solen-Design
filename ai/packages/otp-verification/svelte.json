{"id":"otp-verification","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"OtpVerification.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountOtpVerification, type OtpVerificationOptions } from \"../../components/otp-verification/OtpVerificationEngine.js\";\nimport type { MotionController } from \"../../components/otp-verification/motion-runtime\";\nexport let options: OtpVerificationOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountOtpVerification(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"otp-verification\"></div>\n"}],"core":[{"name":"OtpVerificationEngine.js","path":"src/components/otp-verification/OtpVerificationEngine.js"},{"name":"otp-motion.js","path":"src/components/otp-verification/otp-motion.js"},{"name":"motion-runtime.ts","path":"src/components/otp-verification/motion-runtime.ts"},{"name":"OtpVerificationEngine.d.ts","path":"src/components/otp-verification/OtpVerificationEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { OtpVerification } from \"solen-design/svelte\";\n</script>\n\n<OtpVerification />"}],"api":[{"name":"options","type":"OtpVerificationOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/otp-verification/SPEC.md","detail":"../../components/otp-verification.json"}