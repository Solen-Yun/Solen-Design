{"id":"ridgeline","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"Ridgeline.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountRidgeline, type RidgelineOptions } from \"../../components/ridgeline/RidgelineEngine.js\";\nimport type { MotionController } from \"../../components/ridgeline/motion-runtime\";\nexport let options: RidgelineOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountRidgeline(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"ridgeline\"></div>\n"}],"core":[{"name":"RidgelineEngine.js","path":"src/components/ridgeline/RidgelineEngine.js"},{"name":"motion-runtime.ts","path":"src/components/ridgeline/motion-runtime.ts"},{"name":"RidgelineEngine.d.ts","path":"src/components/ridgeline/RidgelineEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { Ridgeline } from \"solen-design/svelte\";\n</script>\n\n<Ridgeline />"}],"api":[{"name":"options","type":"RidgelineOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/ridgeline/SPEC.md","detail":"../../components/ridgeline.json"}