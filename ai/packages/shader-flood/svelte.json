{"id":"shader-flood","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ShaderFlood.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountShaderFlood, type ShaderFloodOptions } from \"../../components/shader-flood/ShaderFloodEngine.js\";\nimport type { MotionController } from \"../../components/shader-flood/motion-runtime\";\nexport let options: ShaderFloodOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountShaderFlood(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"shader-flood\"></div>\n"}],"core":[{"name":"ShaderFloodEngine.js","path":"src/components/shader-flood/ShaderFloodEngine.js"},{"name":"motion-runtime.ts","path":"src/components/shader-flood/motion-runtime.ts"},{"name":"ShaderFloodEngine.d.ts","path":"src/components/shader-flood/ShaderFloodEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ShaderFlood } from \"solen-design/svelte\";\n</script>\n\n<ShaderFlood />"}],"api":[{"name":"options","type":"ShaderFloodOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/shader-flood/SPEC.md","detail":"../../components/shader-flood.json"}