{"id":"matcha-powder-reveal","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte three@0.185.1","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte three@0.185.1","pnpm":"pnpm add svelte three@0.185.1","yarn":"yarn add svelte three@0.185.1","bun":"bun add svelte three@0.185.1"},"files":[{"name":"MatchaPowderReveal.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMatchaPowderReveal, type MatchaPowderRevealOptions } from \"../../components/matcha-powder-reveal/MatchaPowderRevealEngine.js\";\nimport type { MotionController } from \"../../components/matcha-powder-reveal/motion-runtime\";\nexport let options: MatchaPowderRevealOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMatchaPowderReveal(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"matcha-powder-reveal\"></div>\n"}],"core":[{"name":"MatchaPowderRevealEngine.js","path":"src/components/matcha-powder-reveal/MatchaPowderRevealEngine.js"},{"name":"motion-runtime.ts","path":"src/components/matcha-powder-reveal/motion-runtime.ts"},{"name":"MatchaPowderRevealEngine.d.ts","path":"src/components/matcha-powder-reveal/MatchaPowderRevealEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MatchaPowderReveal } from \"solen-design/svelte\";\n</script>\n\n<MatchaPowderReveal options={{ speed: 1 }} />"}],"api":[{"name":"options","type":"MatchaPowderRevealOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/matcha-powder-reveal/SPEC.md","detail":"../../components/matcha-powder-reveal.json"}