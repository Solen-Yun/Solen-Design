{"id":"laptop-lid","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LaptopLid.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLaptopLid, type LaptopLidOptions } from \"../../components/laptop-lid/LaptopLidEngine.js\";\nimport type { MotionController } from \"../../components/laptop-lid/motion-runtime\";\nexport let options: LaptopLidOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLaptopLid(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"laptop-lid\"></div>\n"}],"core":[{"name":"LaptopLidEngine.js","path":"src/components/laptop-lid/LaptopLidEngine.js"},{"name":"motion-runtime.ts","path":"src/components/laptop-lid/motion-runtime.ts"},{"name":"LaptopLidEngine.d.ts","path":"src/components/laptop-lid/LaptopLidEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LaptopLid } from \"solen-design/svelte\";\n</script>\n\n<LaptopLid />"}],"api":[{"name":"options","type":"LaptopLidOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/laptop-lid/SPEC.md","detail":"../../components/laptop-lid.json"}