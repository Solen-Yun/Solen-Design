{"id":"spider-music-player","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte gsap@3.12.7","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte gsap@3.12.7","pnpm":"pnpm add svelte gsap@3.12.7","yarn":"yarn add svelte gsap@3.12.7","bun":"bun add svelte gsap@3.12.7"},"files":[{"name":"SpiderMusicPlayer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSpiderMusicPlayer, type SpiderMusicPlayerOptions } from \"../../components/spider-music-player/SpiderMusicPlayerEngine.js\";\nimport type { MotionController } from \"../../components/spider-music-player/motion-runtime\";\nexport let options: SpiderMusicPlayerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSpiderMusicPlayer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"spider-music-player\"></div>\n"}],"core":[{"name":"SpiderMusicPlayerEngine.js","path":"src/components/spider-music-player/SpiderMusicPlayerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/spider-music-player/motion-runtime.ts"},{"name":"SpiderMusicPlayerEngine.d.ts","path":"src/components/spider-music-player/SpiderMusicPlayerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SpiderMusicPlayer } from \"solen-design/svelte\";\n</script>\n\n<SpiderMusicPlayer options={{ track: 0 }} />"}],"api":[{"name":"options","type":"SpiderMusicPlayerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/spider-music-player/SPEC.md","detail":"../../components/spider-music-player.json"}