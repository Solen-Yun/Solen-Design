{"id":"spring-tuner","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SpringTuner.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSpringTuner, type SpringTunerOptions } from \"../../components/spring-tuner/SpringTunerEngine.js\";\nimport type { MotionController } from \"../../components/spring-tuner/motion-runtime\";\nexport let options: SpringTunerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSpringTuner(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"spring-tuner\"></div>\n"}],"core":[{"name":"SpringTunerEngine.js","path":"src/components/spring-tuner/SpringTunerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/spring-tuner/motion-runtime.ts"},{"name":"SpringTunerEngine.d.ts","path":"src/components/spring-tuner/SpringTunerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SpringTuner } from \"solen-design/svelte\";\n</script>\n\n<SpringTuner />"}],"api":[{"name":"options","type":"SpringTunerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/spring-tuner/SPEC.md","detail":"../../components/spring-tuner.json"}