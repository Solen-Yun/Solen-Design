{"id":"seo-preview","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SeoPreview.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSeoPreview, type SeoPreviewOptions } from \"../../components/seo-preview/SeoPreviewEngine.js\";\nimport type { MotionController } from \"../../components/seo-preview/motion-runtime\";\nexport let options: SeoPreviewOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSeoPreview(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"seo-preview\"></div>\n"}],"core":[{"name":"SeoPreviewEngine.js","path":"src/components/seo-preview/SeoPreviewEngine.js"},{"name":"motion-runtime.ts","path":"src/components/seo-preview/motion-runtime.ts"},{"name":"SeoPreviewEngine.d.ts","path":"src/components/seo-preview/SeoPreviewEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SeoPreview } from \"solen-design/svelte\";\n</script>\n\n<SeoPreview />"}],"api":[{"name":"options","type":"SeoPreviewOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/seo-preview/SPEC.md","detail":"../../components/seo-preview.json"}