{"id":"rating-breakdown","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"RatingBreakdown.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountRatingBreakdown, type RatingBreakdownOptions } from \"../../components/rating-breakdown/RatingBreakdownEngine.js\";\nimport type { MotionController } from \"../../components/rating-breakdown/motion-runtime\";\nexport let options: RatingBreakdownOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountRatingBreakdown(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"rating-breakdown\"></div>\n"}],"core":[{"name":"RatingBreakdownEngine.js","path":"src/components/rating-breakdown/RatingBreakdownEngine.js"},{"name":"motion-runtime.ts","path":"src/components/rating-breakdown/motion-runtime.ts"},{"name":"RatingBreakdownEngine.d.ts","path":"src/components/rating-breakdown/RatingBreakdownEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { RatingBreakdown } from \"solen-design/svelte\";\n</script>\n\n<RatingBreakdown />"}],"api":[{"name":"options","type":"RatingBreakdownOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/rating-breakdown/SPEC.md","detail":"../../components/rating-breakdown.json"}