{"id":"form-error-jump","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FormErrorJump.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFormErrorJump, type FormErrorJumpOptions } from \"../../components/form-error-jump/FormErrorJumpEngine.js\";\nimport type { MotionController } from \"../../components/form-error-jump/motion-runtime\";\nexport let options: FormErrorJumpOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFormErrorJump(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"form-error-jump\"></div>\n"}],"core":[{"name":"FormErrorJumpEngine.js","path":"src/components/form-error-jump/FormErrorJumpEngine.js"},{"name":"motion-runtime.ts","path":"src/components/form-error-jump/motion-runtime.ts"},{"name":"FormErrorJumpEngine.d.ts","path":"src/components/form-error-jump/FormErrorJumpEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FormErrorJump } from \"solen-design/svelte\";\n</script>\n\n<FormErrorJump />"}],"api":[{"name":"options","type":"FormErrorJumpOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/form-error-jump/SPEC.md","detail":"../../components/form-error-jump.json"}