{"id":"direction-aware-tiles","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DirectionAwareTiles.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDirectionAwareTiles, type DirectionAwareTilesOptions } from \"../../components/direction-aware-tiles/DirectionAwareTilesEngine.js\";\nimport type { MotionController } from \"../../components/direction-aware-tiles/motion-runtime\";\nexport let options: DirectionAwareTilesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDirectionAwareTiles(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"direction-aware-tiles\"></div>\n"}],"core":[{"name":"DirectionAwareTilesEngine.js","path":"src/components/direction-aware-tiles/DirectionAwareTilesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/direction-aware-tiles/motion-runtime.ts"},{"name":"DirectionAwareTilesEngine.d.ts","path":"src/components/direction-aware-tiles/DirectionAwareTilesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DirectionAwareTiles } from \"solen-design/svelte\";\n</script>\n\n<DirectionAwareTiles />"}],"api":[{"name":"options","type":"DirectionAwareTilesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/direction-aware-tiles/SPEC.md","detail":"../../components/direction-aware-tiles.json"}