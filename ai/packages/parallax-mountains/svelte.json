{"id":"parallax-mountains","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ParallaxMountains.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountParallaxMountains, type ParallaxMountainsOptions } from \"../../components/parallax-mountains/ParallaxMountainsEngine.js\";\nimport type { MotionController } from \"../../components/parallax-mountains/motion-runtime\";\nexport let options: ParallaxMountainsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountParallaxMountains(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"parallax-mountains\"></div>\n"}],"core":[{"name":"ParallaxMountainsEngine.js","path":"src/components/parallax-mountains/ParallaxMountainsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/parallax-mountains/motion-runtime.ts"},{"name":"ParallaxMountainsEngine.d.ts","path":"src/components/parallax-mountains/ParallaxMountainsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ParallaxMountains } from \"solen-design/svelte\";\n</script>\n\n<ParallaxMountains />"}],"api":[{"name":"options","type":"ParallaxMountainsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/parallax-mountains/SPEC.md","detail":"../../components/parallax-mountains.json"}