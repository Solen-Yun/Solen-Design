{"id":"sticky-buy-sheet","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StickyBuySheet.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStickyBuySheet, type StickyBuySheetOptions } from \"../../components/sticky-buy-sheet/StickyBuySheetEngine.js\";\nimport type { MotionController } from \"../../components/sticky-buy-sheet/motion-runtime\";\nexport let options: StickyBuySheetOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStickyBuySheet(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"sticky-buy-sheet\"></div>\n"}],"core":[{"name":"StickyBuySheetEngine.js","path":"src/components/sticky-buy-sheet/StickyBuySheetEngine.js"},{"name":"motion-runtime.ts","path":"src/components/sticky-buy-sheet/motion-runtime.ts"},{"name":"StickyBuySheetEngine.d.ts","path":"src/components/sticky-buy-sheet/StickyBuySheetEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StickyBuySheet } from \"solen-design/svelte\";\n</script>\n\n<StickyBuySheet />"}],"api":[{"name":"options","type":"StickyBuySheetOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/sticky-buy-sheet/SPEC.md","detail":"../../components/sticky-buy-sheet.json"}