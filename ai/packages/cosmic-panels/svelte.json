{"id":"cosmic-panels","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CosmicPanels.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCosmicPanels, type CosmicPanelsOptions } from \"../../components/cosmic-panels/CosmicPanelsEngine.js\";\nimport type { MotionController } from \"../../components/cosmic-panels/motion-runtime\";\nexport let options: CosmicPanelsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCosmicPanels(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"cosmic-panels\"></div>\n"}],"core":[{"name":"CosmicPanelsEngine.js","path":"src/components/cosmic-panels/CosmicPanelsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/cosmic-panels/motion-runtime.ts"},{"name":"CosmicPanelsEngine.d.ts","path":"src/components/cosmic-panels/CosmicPanelsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CosmicPanels } from \"solen-design/svelte\";\n</script>\n\n<CosmicPanels />"}],"api":[{"name":"options","type":"CosmicPanelsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/cosmic-panels/SPEC.md","detail":"../../components/cosmic-panels.json"}