{"id":"folded-emoji-scroll","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FoldedEmojiScroll.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFoldedEmojiScroll, type FoldedEmojiScrollOptions } from \"../../components/folded-emoji-scroll/FoldedEmojiScrollEngine.js\";\nimport type { MotionController } from \"../../components/folded-emoji-scroll/motion-runtime\";\nexport let options: FoldedEmojiScrollOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFoldedEmojiScroll(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"folded-emoji-scroll\"></div>\n"}],"core":[{"name":"FoldedEmojiScrollEngine.js","path":"src/components/folded-emoji-scroll/FoldedEmojiScrollEngine.js"},{"name":"motion-runtime.ts","path":"src/components/folded-emoji-scroll/motion-runtime.ts"},{"name":"FoldedEmojiScrollEngine.d.ts","path":"src/components/folded-emoji-scroll/FoldedEmojiScrollEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FoldedEmojiScroll } from \"solen-design/svelte\";\n</script>\n\n<FoldedEmojiScroll options={{ foldSize: 42 }} />"}],"api":[{"name":"options","type":"FoldedEmojiScrollOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/folded-emoji-scroll/SPEC.md","detail":"../../components/folded-emoji-scroll.json"}