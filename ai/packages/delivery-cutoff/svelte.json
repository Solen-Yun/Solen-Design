{"id":"delivery-cutoff","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DeliveryCutoff.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDeliveryCutoff, type DeliveryCutoffOptions } from \"../../components/delivery-cutoff/DeliveryCutoffEngine.js\";\nimport type { MotionController } from \"../../components/delivery-cutoff/motion-runtime\";\nexport let options: DeliveryCutoffOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDeliveryCutoff(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"delivery-cutoff\"></div>\n"}],"core":[{"name":"DeliveryCutoffEngine.js","path":"src/components/delivery-cutoff/DeliveryCutoffEngine.js"},{"name":"motion-runtime.ts","path":"src/components/delivery-cutoff/motion-runtime.ts"},{"name":"DeliveryCutoffEngine.d.ts","path":"src/components/delivery-cutoff/DeliveryCutoffEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DeliveryCutoff } from \"solen-design/svelte\";\n</script>\n\n<DeliveryCutoff />"}],"api":[{"name":"options","type":"DeliveryCutoffOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/delivery-cutoff/SPEC.md","detail":"../../components/delivery-cutoff.json"}