{"id":"deep-agent-composer","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte gsap@3.12.7","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte gsap@3.12.7","pnpm":"pnpm add svelte gsap@3.12.7","yarn":"yarn add svelte gsap@3.12.7","bun":"bun add svelte gsap@3.12.7"},"files":[{"name":"DeepAgentComposer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDeepAgentComposer, type DeepAgentComposerOptions } from \"../../components/deep-agent-composer/DeepAgentComposerEngine.js\";\nimport type { MotionController } from \"../../components/deep-agent-composer/motion-runtime\";\nexport let options: DeepAgentComposerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDeepAgentComposer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"deep-agent-composer\"></div>\n"}],"core":[{"name":"DeepAgentComposerEngine.js","path":"src/components/deep-agent-composer/DeepAgentComposerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/deep-agent-composer/motion-runtime.ts"},{"name":"DeepAgentComposerEngine.d.ts","path":"src/components/deep-agent-composer/DeepAgentComposerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DeepAgentComposer } from \"solen-design/svelte\";\n</script>\n\n<DeepAgentComposer />"}],"api":[{"name":"options","type":"DeepAgentComposerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/deep-agent-composer/SPEC.md","detail":"../../components/deep-agent-composer.json"}