{"id":"starfield-warp","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StarfieldWarp.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStarfieldWarp, type StarfieldWarpOptions } from \"../../components/starfield-warp/StarfieldWarpEngine.js\";\nimport type { MotionController } from \"../../components/starfield-warp/motion-runtime\";\nexport let options: StarfieldWarpOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStarfieldWarp(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"starfield-warp\"></div>\n"}],"core":[{"name":"StarfieldWarpEngine.js","path":"src/components/starfield-warp/StarfieldWarpEngine.js"},{"name":"motion-runtime.ts","path":"src/components/starfield-warp/motion-runtime.ts"},{"name":"StarfieldWarpEngine.d.ts","path":"src/components/starfield-warp/StarfieldWarpEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StarfieldWarp } from \"solen-design/svelte\";\n</script>\n\n<StarfieldWarp />"}],"api":[{"name":"options","type":"StarfieldWarpOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/starfield-warp/SPEC.md","detail":"../../components/starfield-warp.json"}