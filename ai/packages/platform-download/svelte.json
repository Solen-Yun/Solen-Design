{"id":"platform-download","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PlatformDownload.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPlatformDownload, type PlatformDownloadOptions } from \"../../components/platform-download/PlatformDownloadEngine.js\";\nimport type { MotionController } from \"../../components/platform-download/motion-runtime\";\nexport let options: PlatformDownloadOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPlatformDownload(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"platform-download\"></div>\n"}],"core":[{"name":"PlatformDownloadEngine.js","path":"src/components/platform-download/PlatformDownloadEngine.js"},{"name":"motion-runtime.ts","path":"src/components/platform-download/motion-runtime.ts"},{"name":"PlatformDownloadEngine.d.ts","path":"src/components/platform-download/PlatformDownloadEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PlatformDownload } from \"solen-design/svelte\";\n</script>\n\n<PlatformDownload />"}],"api":[{"name":"options","type":"PlatformDownloadOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/platform-download/SPEC.md","detail":"../../components/platform-download.json"}