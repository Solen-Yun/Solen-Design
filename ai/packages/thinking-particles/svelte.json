{"id":"thinking-particles","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ThinkingParticles.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountThinkingParticles, type ThinkingParticlesOptions } from \"../../components/thinking-particles/ThinkingParticlesEngine.js\";\nimport type { MotionController } from \"../../components/thinking-particles/motion-runtime\";\nexport let options: ThinkingParticlesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountThinkingParticles(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"thinking-particles\"></div>\n"}],"core":[{"name":"ThinkingParticlesEngine.js","path":"src/components/thinking-particles/ThinkingParticlesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/thinking-particles/motion-runtime.ts"},{"name":"ThinkingParticlesEngine.d.ts","path":"src/components/thinking-particles/ThinkingParticlesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ThinkingParticles } from \"solen-design/svelte\";\n</script>\n\n<ThinkingParticles />"}],"api":[{"name":"options","type":"ThinkingParticlesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/thinking-particles/SPEC.md","detail":"../../components/thinking-particles.json"}