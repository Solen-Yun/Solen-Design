{"id":"waffle-chart","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"WaffleChart.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountWaffleChart, type WaffleChartOptions } from \"../../components/waffle-chart/WaffleChartEngine.js\";\nimport type { MotionController } from \"../../components/waffle-chart/motion-runtime\";\nexport let options: WaffleChartOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountWaffleChart(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"waffle-chart\"></div>\n"}],"core":[{"name":"WaffleChartEngine.js","path":"src/components/waffle-chart/WaffleChartEngine.js"},{"name":"motion-runtime.ts","path":"src/components/waffle-chart/motion-runtime.ts"},{"name":"WaffleChartEngine.d.ts","path":"src/components/waffle-chart/WaffleChartEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { WaffleChart } from \"solen-design/svelte\";\n</script>\n\n<WaffleChart />"}],"api":[{"name":"options","type":"WaffleChartOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/waffle-chart/SPEC.md","detail":"../../components/waffle-chart.json"}