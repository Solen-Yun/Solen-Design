{"id":"image-compare","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ImageCompare.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountImageCompare, type ImageCompareOptions } from \"../../components/image-compare/ImageCompareEngine.js\";\nimport type { MotionController } from \"../../components/image-compare/motion-runtime\";\nexport let options: ImageCompareOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountImageCompare(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"image-compare\"></div>\n"}],"core":[{"name":"ImageCompareEngine.js","path":"src/components/image-compare/ImageCompareEngine.js"},{"name":"motion-runtime.ts","path":"src/components/image-compare/motion-runtime.ts"},{"name":"ImageCompareEngine.d.ts","path":"src/components/image-compare/ImageCompareEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ImageCompare } from \"solen-design/svelte\";\n</script>\n\n<ImageCompare />"}],"api":[{"name":"options","type":"ImageCompareOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/image-compare/SPEC.md","detail":"../../components/image-compare.json"}