{"id":"docking-mini-player","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DockingMiniPlayer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDockingMiniPlayer, type DockingMiniPlayerOptions } from \"../../components/docking-mini-player/DockingMiniPlayerEngine.js\";\nimport type { MotionController } from \"../../components/docking-mini-player/motion-runtime\";\nexport let options: DockingMiniPlayerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDockingMiniPlayer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"docking-mini-player\"></div>\n"}],"core":[{"name":"DockingMiniPlayerEngine.js","path":"src/components/docking-mini-player/DockingMiniPlayerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/docking-mini-player/motion-runtime.ts"},{"name":"DockingMiniPlayerEngine.d.ts","path":"src/components/docking-mini-player/DockingMiniPlayerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DockingMiniPlayer } from \"solen-design/svelte\";\n</script>\n\n<DockingMiniPlayer />"}],"api":[{"name":"options","type":"DockingMiniPlayerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/docking-mini-player/SPEC.md","detail":"../../components/docking-mini-player.json"}