{"id":"product-hotspots","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ProductHotspots.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountProductHotspots, type ProductHotspotsOptions } from \"../../components/product-hotspots/ProductHotspotsEngine.js\";\nimport type { MotionController } from \"../../components/product-hotspots/motion-runtime\";\nexport let options: ProductHotspotsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountProductHotspots(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"product-hotspots\"></div>\n"}],"core":[{"name":"ProductHotspotsEngine.js","path":"src/components/product-hotspots/ProductHotspotsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/product-hotspots/motion-runtime.ts"},{"name":"ProductHotspotsEngine.d.ts","path":"src/components/product-hotspots/ProductHotspotsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ProductHotspots } from \"solen-design/svelte\";\n</script>\n\n<ProductHotspots />"}],"api":[{"name":"options","type":"ProductHotspotsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/product-hotspots/SPEC.md","detail":"../../components/product-hotspots.json"}