{"id":"bouncy-access-request","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BouncyAccessRequest.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBouncyAccessRequest, type BouncyAccessRequestOptions } from \"../../components/bouncy-access-request/BouncyAccessRequestEngine.js\";\nimport type { MotionController } from \"../../components/bouncy-access-request/motion-runtime\";\nexport let options: BouncyAccessRequestOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBouncyAccessRequest(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"bouncy-access\"></div>\n"}],"core":[{"name":"BouncyAccessRequestEngine.js","path":"src/components/bouncy-access-request/BouncyAccessRequestEngine.js"},{"name":"motion-runtime.ts","path":"src/components/bouncy-access-request/motion-runtime.ts"},{"name":"BouncyAccessRequestEngine.d.ts","path":"src/components/bouncy-access-request/BouncyAccessRequestEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BouncyAccessRequest } from \"solen-design/svelte\";\n</script>\n\n<BouncyAccessRequest />"}],"api":[{"name":"options","type":"BouncyAccessRequestOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/bouncy-access-request/SPEC.md","detail":"../../components/bouncy-access-request.json"}