{"id":"gradient-cover-wall","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GradientCoverWall.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGradientCoverWall, type GradientCoverWallOptions } from \"../../components/gradient-cover-wall/GradientCoverWallEngine.js\";\nimport type { MotionController } from \"../../components/gradient-cover-wall/motion-runtime\";\nexport let options: GradientCoverWallOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGradientCoverWall(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"gradient-cover-wall\"></div>\n"}],"core":[{"name":"GradientCoverWallEngine.js","path":"src/components/gradient-cover-wall/GradientCoverWallEngine.js"},{"name":"motion-runtime.ts","path":"src/components/gradient-cover-wall/motion-runtime.ts"},{"name":"GradientCoverWallEngine.d.ts","path":"src/components/gradient-cover-wall/GradientCoverWallEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GradientCoverWall } from \"solen-design/svelte\";\n</script>\n\n<GradientCoverWall />"}],"api":[{"name":"options","type":"GradientCoverWallOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/gradient-cover-wall/SPEC.md","detail":"../../components/gradient-cover-wall.json"}