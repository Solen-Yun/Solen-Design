{"id":"map-clusters","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MapClusters.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMapClusters, type MapClustersOptions } from \"../../components/map-clusters/MapClustersEngine.js\";\nimport type { MotionController } from \"../../components/map-clusters/motion-runtime\";\nexport let options: MapClustersOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMapClusters(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"map-clusters\"></div>\n"}],"core":[{"name":"MapClustersEngine.js","path":"src/components/map-clusters/MapClustersEngine.js"},{"name":"motion-runtime.ts","path":"src/components/map-clusters/motion-runtime.ts"},{"name":"MapClustersEngine.d.ts","path":"src/components/map-clusters/MapClustersEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MapClusters } from \"solen-design/svelte\";\n</script>\n\n<MapClusters />"}],"api":[{"name":"options","type":"MapClustersOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/map-clusters/SPEC.md","detail":"../../components/map-clusters.json"}