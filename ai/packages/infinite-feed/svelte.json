{"id":"infinite-feed","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"InfiniteFeed.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountInfiniteFeed, type InfiniteFeedOptions } from \"../../components/infinite-feed/InfiniteFeedEngine.js\";\nimport type { MotionController } from \"../../components/infinite-feed/motion-runtime\";\nexport let options: InfiniteFeedOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountInfiniteFeed(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"infinite-feed\"></div>\n"}],"core":[{"name":"InfiniteFeedEngine.js","path":"src/components/infinite-feed/InfiniteFeedEngine.js"},{"name":"motion-runtime.ts","path":"src/components/infinite-feed/motion-runtime.ts"},{"name":"InfiniteFeedEngine.d.ts","path":"src/components/infinite-feed/InfiniteFeedEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { InfiniteFeed } from \"solen-design/svelte\";\n</script>\n\n<InfiniteFeed />"}],"api":[{"name":"options","type":"InfiniteFeedOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/infinite-feed/SPEC.md","detail":"../../components/infinite-feed.json"}