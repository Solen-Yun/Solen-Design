{"id":"blister-dropdown","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BlisterDropdown.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBlisterDropdown, type BlisterDropdownOptions } from \"../../components/blister-dropdown/BlisterDropdownEngine.js\";\nimport type { MotionController } from \"../../components/blister-dropdown/motion-runtime\";\nexport let options: BlisterDropdownOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBlisterDropdown(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"blister-dropdown\"></div>\n"}],"core":[{"name":"BlisterDropdownEngine.js","path":"src/components/blister-dropdown/BlisterDropdownEngine.js"},{"name":"motion-runtime.ts","path":"src/components/blister-dropdown/motion-runtime.ts"},{"name":"BlisterDropdownEngine.d.ts","path":"src/components/blister-dropdown/BlisterDropdownEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BlisterDropdown } from \"solen-design/svelte\";\n</script>\n\n<BlisterDropdown />"}],"api":[{"name":"options","type":"BlisterDropdownOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/blister-dropdown/SPEC.md","detail":"../../components/blister-dropdown.json"}