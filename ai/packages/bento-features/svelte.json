{"id":"bento-features","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BentoFeatures.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBentoFeatures, type BentoFeaturesOptions } from \"../../components/bento-features/BentoFeaturesEngine.js\";\nimport type { MotionController } from \"../../components/bento-features/motion-runtime\";\nexport let options: BentoFeaturesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBentoFeatures(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"bento-features\"></div>\n"}],"core":[{"name":"BentoFeaturesEngine.js","path":"src/components/bento-features/BentoFeaturesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/bento-features/motion-runtime.ts"},{"name":"BentoFeaturesEngine.d.ts","path":"src/components/bento-features/BentoFeaturesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BentoFeatures } from \"solen-design/svelte\";\n</script>\n\n<BentoFeatures />"}],"api":[{"name":"options","type":"BentoFeaturesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/bento-features/SPEC.md","detail":"../../components/bento-features.json"}