{"id":"photo-trail","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PhotoTrail.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPhotoTrail, type PhotoTrailOptions } from \"../../components/photo-trail/PhotoTrailEngine.js\";\nimport type { MotionController } from \"../../components/photo-trail/motion-runtime\";\nexport let options: PhotoTrailOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPhotoTrail(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"photo-trail\"></div>\n"}],"core":[{"name":"PhotoTrailEngine.js","path":"src/components/photo-trail/PhotoTrailEngine.js"},{"name":"motion-runtime.ts","path":"src/components/photo-trail/motion-runtime.ts"},{"name":"PhotoTrailEngine.d.ts","path":"src/components/photo-trail/PhotoTrailEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PhotoTrail } from \"solen-design/svelte\";\n</script>\n\n<PhotoTrail />"}],"api":[{"name":"options","type":"PhotoTrailOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/photo-trail/SPEC.md","detail":"../../components/photo-trail.json"}