{"id":"circular-text-badge","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CircularTextBadge.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCircularTextBadge, type CircularTextBadgeOptions } from \"../../components/circular-text-badge/CircularTextBadgeEngine.js\";\nimport type { MotionController } from \"../../components/circular-text-badge/motion-runtime\";\nexport let options: CircularTextBadgeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCircularTextBadge(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"circular-text-badge\"></div>\n"}],"core":[{"name":"CircularTextBadgeEngine.js","path":"src/components/circular-text-badge/CircularTextBadgeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/circular-text-badge/motion-runtime.ts"},{"name":"CircularTextBadgeEngine.d.ts","path":"src/components/circular-text-badge/CircularTextBadgeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CircularTextBadge } from \"solen-design/svelte\";\n</script>\n\n<CircularTextBadge />"}],"api":[{"name":"options","type":"CircularTextBadgeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/circular-text-badge/SPEC.md","detail":"../../components/circular-text-badge.json"}