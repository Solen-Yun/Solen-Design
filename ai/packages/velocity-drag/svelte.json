{"id":"velocity-drag","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"VelocityFocusDrag.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountVelocityFocusDrag, type VelocityFocusDragOptions } from \"../../components/velocity-drag/VelocityFocusDragEngine.js\";\nimport type { MotionController } from \"../../components/velocity-drag/motion-runtime\";\nexport let options: VelocityFocusDragOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountVelocityFocusDrag(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"velocity-drag\"></div>\n"}],"core":[{"name":"VelocityFocusDragEngine.js","path":"src/components/velocity-drag/VelocityFocusDragEngine.js"},{"name":"motion-runtime.ts","path":"src/components/velocity-drag/motion-runtime.ts"},{"name":"VelocityFocusDragEngine.d.ts","path":"src/components/velocity-drag/VelocityFocusDragEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { VelocityFocusDrag } from \"solen-design/svelte\";\n</script>\n\n<VelocityFocusDrag />"}],"api":[{"name":"options","type":"VelocityFocusDragOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/velocity-drag/SPEC.md","detail":"../../components/velocity-drag.json"}