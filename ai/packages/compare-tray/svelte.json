{"id":"compare-tray","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CompareTray.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCompareTray, type CompareTrayOptions } from \"../../components/compare-tray/CompareTrayEngine.js\";\nimport type { MotionController } from \"../../components/compare-tray/motion-runtime\";\nexport let options: CompareTrayOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCompareTray(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"compare-tray\"></div>\n"}],"core":[{"name":"CompareTrayEngine.js","path":"src/components/compare-tray/CompareTrayEngine.js"},{"name":"motion-runtime.ts","path":"src/components/compare-tray/motion-runtime.ts"},{"name":"CompareTrayEngine.d.ts","path":"src/components/compare-tray/CompareTrayEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CompareTray } from \"solen-design/svelte\";\n</script>\n\n<CompareTray />"}],"api":[{"name":"options","type":"CompareTrayOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/compare-tray/SPEC.md","detail":"../../components/compare-tray.json"}