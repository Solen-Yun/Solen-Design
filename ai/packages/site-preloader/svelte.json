{"id":"site-preloader","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SitePreloader.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSitePreloader, type SitePreloaderOptions } from \"../../components/site-preloader/SitePreloaderEngine.js\";\nimport type { MotionController } from \"../../components/site-preloader/motion-runtime\";\nexport let options: SitePreloaderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSitePreloader(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"site-preloader\"></div>\n"}],"core":[{"name":"SitePreloaderEngine.js","path":"src/components/site-preloader/SitePreloaderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/site-preloader/motion-runtime.ts"},{"name":"SitePreloaderEngine.d.ts","path":"src/components/site-preloader/SitePreloaderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SitePreloader } from \"solen-design/svelte\";\n</script>\n\n<SitePreloader />"}],"api":[{"name":"options","type":"SitePreloaderOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/site-preloader/SPEC.md","detail":"../../components/site-preloader.json"}