{"id":"collection-layout-morph","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte gsap@3.12.7","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte gsap@3.12.7","pnpm":"pnpm add svelte gsap@3.12.7","yarn":"yarn add svelte gsap@3.12.7","bun":"bun add svelte gsap@3.12.7"},"files":[{"name":"CollectionLayoutMorph.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCollectionLayoutMorph, type CollectionLayoutMorphOptions } from \"../../components/collection-layout-morph/CollectionLayoutMorphEngine.js\";\nimport type { MotionController } from \"../../components/collection-layout-morph/motion-runtime\";\nexport let options: CollectionLayoutMorphOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCollectionLayoutMorph(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"collection-layout-morph\"></div>\n"}],"core":[{"name":"CollectionLayoutMorphEngine.js","path":"src/components/collection-layout-morph/CollectionLayoutMorphEngine.js"},{"name":"motion-runtime.ts","path":"src/components/collection-layout-morph/motion-runtime.ts"},{"name":"CollectionLayoutMorphEngine.d.ts","path":"src/components/collection-layout-morph/CollectionLayoutMorphEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CollectionLayoutMorph } from \"solen-design/svelte\";\n</script>\n\n<CollectionLayoutMorph />"}],"api":[{"name":"options","type":"CollectionLayoutMorphOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/collection-layout-morph/SPEC.md","detail":"../../components/collection-layout-morph.json"}