{"id":"aurora-mesh","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AuroraMesh.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAuroraMesh, type AuroraMeshOptions } from \"../../components/aurora-mesh/AuroraMeshEngine.js\";\nimport type { MotionController } from \"../../components/aurora-mesh/motion-runtime\";\nexport let options: AuroraMeshOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAuroraMesh(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"aurora-mesh\"></div>\n"}],"core":[{"name":"AuroraMeshEngine.js","path":"src/components/aurora-mesh/AuroraMeshEngine.js"},{"name":"motion-runtime.ts","path":"src/components/aurora-mesh/motion-runtime.ts"},{"name":"AuroraMeshEngine.d.ts","path":"src/components/aurora-mesh/AuroraMeshEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AuroraMesh } from \"solen-design/svelte\";\n</script>\n\n<AuroraMesh />"}],"api":[{"name":"options","type":"AuroraMeshOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/aurora-mesh/SPEC.md","detail":"../../components/aurora-mesh.json"}