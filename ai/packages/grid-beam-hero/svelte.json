{"id":"grid-beam-hero","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GridBeamHero.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGridBeamHero, type GridBeamHeroOptions } from \"../../components/grid-beam-hero/GridBeamHeroEngine.js\";\nimport type { MotionController } from \"../../components/grid-beam-hero/motion-runtime\";\nexport let options: GridBeamHeroOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGridBeamHero(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"grid-beam-hero\"></div>\n"}],"core":[{"name":"GridBeamHeroEngine.js","path":"src/components/grid-beam-hero/GridBeamHeroEngine.js"},{"name":"motion-runtime.ts","path":"src/components/grid-beam-hero/motion-runtime.ts"},{"name":"GridBeamHeroEngine.d.ts","path":"src/components/grid-beam-hero/GridBeamHeroEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GridBeamHero } from \"solen-design/svelte\";\n</script>\n\n<GridBeamHero />"}],"api":[{"name":"options","type":"GridBeamHeroOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/grid-beam-hero/SPEC.md","detail":"../../components/grid-beam-hero.json"}