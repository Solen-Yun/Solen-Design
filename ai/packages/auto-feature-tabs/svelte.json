{"id":"auto-feature-tabs","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AutoFeatureTabs.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAutoFeatureTabs, type AutoFeatureTabsOptions } from \"../../components/auto-feature-tabs/AutoFeatureTabsEngine.js\";\nimport type { MotionController } from \"../../components/auto-feature-tabs/motion-runtime\";\nexport let options: AutoFeatureTabsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAutoFeatureTabs(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"auto-feature-tabs\"></div>\n"}],"core":[{"name":"AutoFeatureTabsEngine.js","path":"src/components/auto-feature-tabs/AutoFeatureTabsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/auto-feature-tabs/motion-runtime.ts"},{"name":"AutoFeatureTabsEngine.d.ts","path":"src/components/auto-feature-tabs/AutoFeatureTabsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AutoFeatureTabs } from \"solen-design/svelte\";\n</script>\n\n<AutoFeatureTabs />"}],"api":[{"name":"options","type":"AutoFeatureTabsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/auto-feature-tabs/SPEC.md","detail":"../../components/auto-feature-tabs.json"}