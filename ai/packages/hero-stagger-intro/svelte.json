{"id":"hero-stagger-intro","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"HeroStaggerIntro.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountHeroStaggerIntro, type HeroStaggerIntroOptions } from \"../../components/hero-stagger-intro/HeroStaggerIntroEngine.js\";\nimport type { MotionController } from \"../../components/hero-stagger-intro/motion-runtime\";\nexport let options: HeroStaggerIntroOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountHeroStaggerIntro(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"hero-stagger-intro\"></div>\n"}],"core":[{"name":"HeroStaggerIntroEngine.js","path":"src/components/hero-stagger-intro/HeroStaggerIntroEngine.js"},{"name":"motion-runtime.ts","path":"src/components/hero-stagger-intro/motion-runtime.ts"},{"name":"HeroStaggerIntroEngine.d.ts","path":"src/components/hero-stagger-intro/HeroStaggerIntroEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { HeroStaggerIntro } from \"solen-design/svelte\";\n</script>\n\n<HeroStaggerIntro />"}],"api":[{"name":"options","type":"HeroStaggerIntroOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/hero-stagger-intro/SPEC.md","detail":"../../components/hero-stagger-intro.json"}