{"id":"palette-generator","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PaletteGenerator.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPaletteGenerator, type PaletteGeneratorOptions } from \"../../components/palette-generator/PaletteGeneratorEngine.js\";\nimport type { MotionController } from \"../../components/palette-generator/motion-runtime\";\nexport let options: PaletteGeneratorOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPaletteGenerator(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"palette-generator\"></div>\n"}],"core":[{"name":"PaletteGeneratorEngine.js","path":"src/components/palette-generator/PaletteGeneratorEngine.js"},{"name":"motion-runtime.ts","path":"src/components/palette-generator/motion-runtime.ts"},{"name":"PaletteGeneratorEngine.d.ts","path":"src/components/palette-generator/PaletteGeneratorEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PaletteGenerator } from \"solen-design/svelte\";\n</script>\n\n<PaletteGenerator />"}],"api":[{"name":"options","type":"PaletteGeneratorOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/palette-generator/SPEC.md","detail":"../../components/palette-generator.json"}