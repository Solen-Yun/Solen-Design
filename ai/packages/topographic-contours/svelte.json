{"id":"topographic-contours","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TopographicContours.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTopographicContours, type TopographicContoursOptions } from \"../../components/topographic-contours/TopographicContoursEngine.js\";\nimport type { MotionController } from \"../../components/topographic-contours/motion-runtime\";\nexport let options: TopographicContoursOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTopographicContours(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"topographic-contours\"></div>\n"}],"core":[{"name":"TopographicContoursEngine.js","path":"src/components/topographic-contours/TopographicContoursEngine.js"},{"name":"motion-runtime.ts","path":"src/components/topographic-contours/motion-runtime.ts"},{"name":"TopographicContoursEngine.d.ts","path":"src/components/topographic-contours/TopographicContoursEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TopographicContours } from \"solen-design/svelte\";\n</script>\n\n<TopographicContours />"}],"api":[{"name":"options","type":"TopographicContoursOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/topographic-contours/SPEC.md","detail":"../../components/topographic-contours.json"}