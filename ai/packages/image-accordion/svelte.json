{"id":"image-accordion","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ImageAccordion.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountImageAccordion, type ImageAccordionOptions } from \"../../components/image-accordion/ImageAccordionEngine.js\";\nimport type { MotionController } from \"../../components/image-accordion/motion-runtime\";\nexport let options: ImageAccordionOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountImageAccordion(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"image-accordion\"></div>\n"}],"core":[{"name":"ImageAccordionEngine.js","path":"src/components/image-accordion/ImageAccordionEngine.js"},{"name":"motion-runtime.ts","path":"src/components/image-accordion/motion-runtime.ts"},{"name":"ImageAccordionEngine.d.ts","path":"src/components/image-accordion/ImageAccordionEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ImageAccordion } from \"solen-design/svelte\";\n</script>\n\n<ImageAccordion />"}],"api":[{"name":"options","type":"ImageAccordionOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/image-accordion/SPEC.md","detail":"../../components/image-accordion.json"}