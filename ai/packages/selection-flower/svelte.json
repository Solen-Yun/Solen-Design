{"id":"selection-flower","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SelectionFlower.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSelectionFlower, type SelectionFlowerOptions } from \"../../components/selection-flower/SelectionFlowerEngine.js\";\nimport type { MotionController } from \"../../components/selection-flower/motion-runtime\";\nexport let options: SelectionFlowerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSelectionFlower(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"selection-flower\"></div>\n"}],"core":[{"name":"SelectionFlowerEngine.js","path":"src/components/selection-flower/SelectionFlowerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/selection-flower/motion-runtime.ts"},{"name":"SelectionFlowerEngine.d.ts","path":"src/components/selection-flower/SelectionFlowerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SelectionFlower } from \"solen-design/svelte\";\n</script>\n\n<SelectionFlower />"}],"api":[{"name":"options","type":"SelectionFlowerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/selection-flower/SPEC.md","detail":"../../components/selection-flower.json"}