{"id":"support-chat-widget","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"SupportChatWidget.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountSupportChatWidget, type SupportChatWidgetOptions } from \"../../components/support-chat-widget/SupportChatWidgetEngine.js\";\nimport type { MotionController } from \"../../components/support-chat-widget/motion-runtime\";\nexport let options: SupportChatWidgetOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountSupportChatWidget(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"support-chat-widget\"></div>\n"}],"core":[{"name":"SupportChatWidgetEngine.js","path":"src/components/support-chat-widget/SupportChatWidgetEngine.js"},{"name":"motion-runtime.ts","path":"src/components/support-chat-widget/motion-runtime.ts"},{"name":"SupportChatWidgetEngine.d.ts","path":"src/components/support-chat-widget/SupportChatWidgetEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { SupportChatWidget } from \"solen-design/svelte\";\n</script>\n\n<SupportChatWidget />"}],"api":[{"name":"options","type":"SupportChatWidgetOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/support-chat-widget/SPEC.md","detail":"../../components/support-chat-widget.json"}