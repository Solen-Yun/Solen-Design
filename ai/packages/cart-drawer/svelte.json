{"id":"cart-drawer","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CartDrawer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCartDrawer, type CartDrawerOptions } from \"../../components/cart-drawer/CartDrawerEngine.js\";\nimport type { MotionController } from \"../../components/cart-drawer/motion-runtime\";\nexport let options: CartDrawerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCartDrawer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"cart-drawer\"></div>\n"}],"core":[{"name":"CartDrawerEngine.js","path":"src/components/cart-drawer/CartDrawerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/cart-drawer/motion-runtime.ts"},{"name":"CartDrawerEngine.d.ts","path":"src/components/cart-drawer/CartDrawerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CartDrawer } from \"solen-design/svelte\";\n</script>\n\n<CartDrawer />"}],"api":[{"name":"options","type":"CartDrawerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/cart-drawer/SPEC.md","detail":"../../components/cart-drawer.json"}