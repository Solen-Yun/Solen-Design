{"id":"glass-folder","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GlassFolder.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGlassFolder, type GlassFolderOptions } from \"../../components/glass-folder/GlassFolderEngine.js\";\nimport type { MotionController } from \"../../components/glass-folder/motion-runtime\";\nexport let options: GlassFolderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGlassFolder(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"glass-folder\"></div>\n"}],"core":[{"name":"GlassFolderEngine.js","path":"src/components/glass-folder/GlassFolderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/glass-folder/motion-runtime.ts"},{"name":"GlassFolderEngine.d.ts","path":"src/components/glass-folder/GlassFolderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GlassFolder } from \"solen-design/svelte\";\n</script>\n\n<GlassFolder />"}],"api":[{"name":"options","type":"GlassFolderOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/glass-folder/SPEC.md","detail":"../../components/glass-folder.json"}