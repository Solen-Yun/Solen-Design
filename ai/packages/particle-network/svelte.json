{"id":"particle-network","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ParticleNetwork.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountParticleNetwork, type ParticleNetworkOptions } from \"../../components/particle-network/ParticleNetworkEngine.js\";\nimport type { MotionController } from \"../../components/particle-network/motion-runtime\";\nexport let options: ParticleNetworkOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountParticleNetwork(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"particle-network\"></div>\n"}],"core":[{"name":"ParticleNetworkEngine.js","path":"src/components/particle-network/ParticleNetworkEngine.js"},{"name":"motion-runtime.ts","path":"src/components/particle-network/motion-runtime.ts"},{"name":"ParticleNetworkEngine.d.ts","path":"src/components/particle-network/ParticleNetworkEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ParticleNetwork } from \"solen-design/svelte\";\n</script>\n\n<ParticleNetwork />"}],"api":[{"name":"options","type":"ParticleNetworkOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/particle-network/SPEC.md","detail":"../../components/particle-network.json"}