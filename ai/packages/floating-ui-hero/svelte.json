{"id":"floating-ui-hero","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FloatingUiHero.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFloatingUiHero, type FloatingUiHeroOptions } from \"../../components/floating-ui-hero/FloatingUiHeroEngine.js\";\nimport type { MotionController } from \"../../components/floating-ui-hero/motion-runtime\";\nexport let options: FloatingUiHeroOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFloatingUiHero(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"floating-ui-hero\"></div>\n"}],"core":[{"name":"FloatingUiHeroEngine.js","path":"src/components/floating-ui-hero/FloatingUiHeroEngine.js"},{"name":"motion-runtime.ts","path":"src/components/floating-ui-hero/motion-runtime.ts"},{"name":"FloatingUiHeroEngine.d.ts","path":"src/components/floating-ui-hero/FloatingUiHeroEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FloatingUiHero } from \"solen-design/svelte\";\n</script>\n\n<FloatingUiHero />"}],"api":[{"name":"options","type":"FloatingUiHeroOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/floating-ui-hero/SPEC.md","detail":"../../components/floating-ui-hero.json"}