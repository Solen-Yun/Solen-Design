{"id":"underline-styles","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"UnderlineStyles.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountUnderlineStyles, type UnderlineStylesOptions } from \"../../components/underline-styles/UnderlineStylesEngine.js\";\nimport type { MotionController } from \"../../components/underline-styles/motion-runtime\";\nexport let options: UnderlineStylesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountUnderlineStyles(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"underline-styles\"></div>\n"}],"core":[{"name":"UnderlineStylesEngine.js","path":"src/components/underline-styles/UnderlineStylesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/underline-styles/motion-runtime.ts"},{"name":"UnderlineStylesEngine.d.ts","path":"src/components/underline-styles/UnderlineStylesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { UnderlineStyles } from \"solen-design/svelte\";\n</script>\n\n<UnderlineStyles />"}],"api":[{"name":"options","type":"UnderlineStylesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/underline-styles/SPEC.md","detail":"../../components/underline-styles.json"}