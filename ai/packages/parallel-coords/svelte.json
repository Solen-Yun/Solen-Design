{"id":"parallel-coords","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ParallelCoords.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountParallelCoords, type ParallelCoordsOptions } from \"../../components/parallel-coords/ParallelCoordsEngine.js\";\nimport type { MotionController } from \"../../components/parallel-coords/motion-runtime\";\nexport let options: ParallelCoordsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountParallelCoords(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"parallel-coords\"></div>\n"}],"core":[{"name":"ParallelCoordsEngine.js","path":"src/components/parallel-coords/ParallelCoordsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/parallel-coords/motion-runtime.ts"},{"name":"ParallelCoordsEngine.d.ts","path":"src/components/parallel-coords/ParallelCoordsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ParallelCoords } from \"solen-design/svelte\";\n</script>\n\n<ParallelCoords />"}],"api":[{"name":"options","type":"ParallelCoordsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/parallel-coords/SPEC.md","detail":"../../components/parallel-coords.json"}