{"id":"link-shortener","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LinkShortener.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLinkShortener, type LinkShortenerOptions } from \"../../components/link-shortener/LinkShortenerEngine.js\";\nimport type { MotionController } from \"../../components/link-shortener/motion-runtime\";\nexport let options: LinkShortenerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLinkShortener(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"link-shortener\"></div>\n"}],"core":[{"name":"LinkShortenerEngine.js","path":"src/components/link-shortener/LinkShortenerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/link-shortener/motion-runtime.ts"},{"name":"LinkShortenerEngine.d.ts","path":"src/components/link-shortener/LinkShortenerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LinkShortener } from \"solen-design/svelte\";\n</script>\n\n<LinkShortener />"}],"api":[{"name":"options","type":"LinkShortenerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/link-shortener/SPEC.md","detail":"../../components/link-shortener.json"}