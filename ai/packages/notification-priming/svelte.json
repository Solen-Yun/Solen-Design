{"id":"notification-priming","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"NotificationPriming.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountNotificationPriming, type NotificationPrimingOptions } from \"../../components/notification-priming/NotificationPrimingEngine.js\";\nimport type { MotionController } from \"../../components/notification-priming/motion-runtime\";\nexport let options: NotificationPrimingOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountNotificationPriming(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"notification-priming\"></div>\n"}],"core":[{"name":"NotificationPrimingEngine.js","path":"src/components/notification-priming/NotificationPrimingEngine.js"},{"name":"motion-runtime.ts","path":"src/components/notification-priming/motion-runtime.ts"},{"name":"NotificationPrimingEngine.d.ts","path":"src/components/notification-priming/NotificationPrimingEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { NotificationPriming } from \"solen-design/svelte\";\n</script>\n\n<NotificationPriming />"}],"api":[{"name":"options","type":"NotificationPrimingOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/notification-priming/SPEC.md","detail":"../../components/notification-priming.json"}