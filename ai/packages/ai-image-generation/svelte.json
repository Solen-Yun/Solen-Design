{"id":"ai-image-generation","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AiImageGeneration.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAiImageGeneration, type AiImageGenerationOptions } from \"../../components/ai-image-generation/AiImageGenerationEngine.js\";\nimport type { MotionController } from \"../../components/ai-image-generation/motion-runtime\";\nexport let options: AiImageGenerationOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAiImageGeneration(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"ai-generating\"></div>\n"}],"core":[{"name":"AiImageGenerationEngine.js","path":"src/components/ai-image-generation/AiImageGenerationEngine.js"},{"name":"motion-runtime.ts","path":"src/components/ai-image-generation/motion-runtime.ts"},{"name":"AiImageGenerationEngine.d.ts","path":"src/components/ai-image-generation/AiImageGenerationEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AiImageGeneration } from \"solen-design/svelte\";\n</script>\n\n<AiImageGeneration />"}],"api":[{"name":"options","type":"AiImageGenerationOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/ai-image-generation/SPEC.md","detail":"../../components/ai-image-generation.json"}