{"id":"filter-drawer","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"FilterDrawer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFilterDrawer, type FilterDrawerOptions } from \"../../components/filter-drawer/FilterDrawerEngine.js\";\nimport type { MotionController } from \"../../components/filter-drawer/motion-runtime\";\nexport let options: FilterDrawerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFilterDrawer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"filter-drawer\"></div>\n"}],"core":[{"name":"FilterDrawerEngine.js","path":"src/components/filter-drawer/FilterDrawerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/filter-drawer/motion-runtime.ts"},{"name":"FilterDrawerEngine.d.ts","path":"src/components/filter-drawer/FilterDrawerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FilterDrawer } from \"solen-design/svelte\";\n</script>\n\n<FilterDrawer />"}],"api":[{"name":"options","type":"FilterDrawerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/filter-drawer/SPEC.md","detail":"../../components/filter-drawer.json"}