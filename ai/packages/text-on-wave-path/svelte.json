{"id":"text-on-wave-path","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TextOnWavePath.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTextOnWavePath, type TextOnWavePathOptions } from \"../../components/text-on-wave-path/TextOnWavePathEngine.js\";\nimport type { MotionController } from \"../../components/text-on-wave-path/motion-runtime\";\nexport let options: TextOnWavePathOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTextOnWavePath(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"text-on-wave-path\"></div>\n"}],"core":[{"name":"TextOnWavePathEngine.js","path":"src/components/text-on-wave-path/TextOnWavePathEngine.js"},{"name":"motion-runtime.ts","path":"src/components/text-on-wave-path/motion-runtime.ts"},{"name":"TextOnWavePathEngine.d.ts","path":"src/components/text-on-wave-path/TextOnWavePathEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TextOnWavePath } from \"solen-design/svelte\";\n</script>\n\n<TextOnWavePath />"}],"api":[{"name":"options","type":"TextOnWavePathOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/text-on-wave-path/SPEC.md","detail":"../../components/text-on-wave-path.json"}