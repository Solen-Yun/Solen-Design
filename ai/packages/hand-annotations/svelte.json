{"id":"hand-annotations","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"HandAnnotations.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountHandAnnotations, type HandAnnotationsOptions } from \"../../components/hand-annotations/HandAnnotationsEngine.js\";\nimport type { MotionController } from \"../../components/hand-annotations/motion-runtime\";\nexport let options: HandAnnotationsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountHandAnnotations(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"hand-annotations\"></div>\n"}],"core":[{"name":"HandAnnotationsEngine.js","path":"src/components/hand-annotations/HandAnnotationsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/hand-annotations/motion-runtime.ts"},{"name":"HandAnnotationsEngine.d.ts","path":"src/components/hand-annotations/HandAnnotationsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { HandAnnotations } from \"solen-design/svelte\";\n</script>\n\n<HandAnnotations />"}],"api":[{"name":"options","type":"HandAnnotationsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/hand-annotations/SPEC.md","detail":"../../components/hand-annotations.json"}