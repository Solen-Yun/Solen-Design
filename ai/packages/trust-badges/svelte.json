{"id":"trust-badges","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TrustBadges.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTrustBadges, type TrustBadgesOptions } from \"../../components/trust-badges/TrustBadgesEngine.js\";\nimport type { MotionController } from \"../../components/trust-badges/motion-runtime\";\nexport let options: TrustBadgesOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTrustBadges(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"trust-badges\"></div>\n"}],"core":[{"name":"TrustBadgesEngine.js","path":"src/components/trust-badges/TrustBadgesEngine.js"},{"name":"motion-runtime.ts","path":"src/components/trust-badges/motion-runtime.ts"},{"name":"TrustBadgesEngine.d.ts","path":"src/components/trust-badges/TrustBadgesEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TrustBadges } from \"solen-design/svelte\";\n</script>\n\n<TrustBadges />"}],"api":[{"name":"options","type":"TrustBadgesOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/trust-badges/SPEC.md","detail":"../../components/trust-badges.json"}