{"id":"block-page-builder","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BlockPageBuilder.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBlockPageBuilder, type BlockPageBuilderOptions } from \"../../components/block-page-builder/BlockPageBuilderEngine.js\";\nimport type { MotionController } from \"../../components/block-page-builder/motion-runtime\";\nexport let options: BlockPageBuilderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBlockPageBuilder(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"block-page-builder\"></div>\n"}],"core":[{"name":"BlockPageBuilderEngine.js","path":"src/components/block-page-builder/BlockPageBuilderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/block-page-builder/motion-runtime.ts"},{"name":"BlockPageBuilderEngine.d.ts","path":"src/components/block-page-builder/BlockPageBuilderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BlockPageBuilder } from \"solen-design/svelte\";\n</script>\n\n<BlockPageBuilder />"}],"api":[{"name":"options","type":"BlockPageBuilderOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/block-page-builder/SPEC.md","detail":"../../components/block-page-builder.json"}