{"id":"scroll-draw-route","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ScrollDrawRoute.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountScrollDrawRoute, type ScrollDrawRouteOptions } from \"../../components/scroll-draw-route/ScrollDrawRouteEngine.js\";\nimport type { MotionController } from \"../../components/scroll-draw-route/motion-runtime\";\nexport let options: ScrollDrawRouteOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountScrollDrawRoute(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"scroll-draw-route\"></div>\n"}],"core":[{"name":"ScrollDrawRouteEngine.js","path":"src/components/scroll-draw-route/ScrollDrawRouteEngine.js"},{"name":"motion-runtime.ts","path":"src/components/scroll-draw-route/motion-runtime.ts"},{"name":"ScrollDrawRouteEngine.d.ts","path":"src/components/scroll-draw-route/ScrollDrawRouteEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ScrollDrawRoute } from \"solen-design/svelte\";\n</script>\n\n<ScrollDrawRoute />"}],"api":[{"name":"options","type":"ScrollDrawRouteOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/scroll-draw-route/SPEC.md","detail":"../../components/scroll-draw-route.json"}