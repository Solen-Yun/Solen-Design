{"id":"map-pin-drop","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MapPinDrop.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMapPinDrop, type MapPinDropOptions } from \"../../components/map-pin-drop/MapPinDropEngine.js\";\nimport type { MotionController } from \"../../components/map-pin-drop/motion-runtime\";\nexport let options: MapPinDropOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMapPinDrop(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"map-pin-drop\"></div>\n"}],"core":[{"name":"MapPinDropEngine.js","path":"src/components/map-pin-drop/MapPinDropEngine.js"},{"name":"motion-runtime.ts","path":"src/components/map-pin-drop/motion-runtime.ts"},{"name":"MapPinDropEngine.d.ts","path":"src/components/map-pin-drop/MapPinDropEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MapPinDrop } from \"solen-design/svelte\";\n</script>\n\n<MapPinDrop />"}],"api":[{"name":"options","type":"MapPinDropOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/map-pin-drop/SPEC.md","detail":"../../components/map-pin-drop.json"}