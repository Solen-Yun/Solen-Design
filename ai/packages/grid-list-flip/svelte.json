{"id":"grid-list-flip","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GridListFlip.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGridListFlip, type GridListFlipOptions } from \"../../components/grid-list-flip/GridListFlipEngine.js\";\nimport type { MotionController } from \"../../components/grid-list-flip/motion-runtime\";\nexport let options: GridListFlipOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGridListFlip(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"grid-list-flip\"></div>\n"}],"core":[{"name":"GridListFlipEngine.js","path":"src/components/grid-list-flip/GridListFlipEngine.js"},{"name":"motion-runtime.ts","path":"src/components/grid-list-flip/motion-runtime.ts"},{"name":"GridListFlipEngine.d.ts","path":"src/components/grid-list-flip/GridListFlipEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GridListFlip } from \"solen-design/svelte\";\n</script>\n\n<GridListFlip />"}],"api":[{"name":"options","type":"GridListFlipOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/grid-list-flip/SPEC.md","detail":"../../components/grid-list-flip.json"}