{"id":"letters-scatter","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"LettersScatter.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountLettersScatter, type LettersScatterOptions } from \"../../components/letters-scatter/LettersScatterEngine.js\";\nimport type { MotionController } from \"../../components/letters-scatter/motion-runtime\";\nexport let options: LettersScatterOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountLettersScatter(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"letters-scatter\"></div>\n"}],"core":[{"name":"LettersScatterEngine.js","path":"src/components/letters-scatter/LettersScatterEngine.js"},{"name":"motion-runtime.ts","path":"src/components/letters-scatter/motion-runtime.ts"},{"name":"LettersScatterEngine.d.ts","path":"src/components/letters-scatter/LettersScatterEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { LettersScatter } from \"solen-design/svelte\";\n</script>\n\n<LettersScatter />"}],"api":[{"name":"options","type":"LettersScatterOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/letters-scatter/SPEC.md","detail":"../../components/letters-scatter.json"}