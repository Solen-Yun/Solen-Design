{"id":"crumpled-paper","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"CrumpledPaper.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountCrumpledPaper, type CrumpledPaperOptions } from \"../../components/crumpled-paper/CrumpledPaperEngine.js\";\nimport type { MotionController } from \"../../components/crumpled-paper/motion-runtime\";\nexport let options: CrumpledPaperOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountCrumpledPaper(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"crumpled-paper\"></div>\n"}],"core":[{"name":"CrumpledPaperEngine.js","path":"src/components/crumpled-paper/CrumpledPaperEngine.js"},{"name":"motion-runtime.ts","path":"src/components/crumpled-paper/motion-runtime.ts"},{"name":"CrumpledPaperEngine.d.ts","path":"src/components/crumpled-paper/CrumpledPaperEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { CrumpledPaper } from \"solen-design/svelte\";\n</script>\n\n<CrumpledPaper />"}],"api":[{"name":"options","type":"CrumpledPaperOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/crumpled-paper/SPEC.md","detail":"../../components/crumpled-paper.json"}