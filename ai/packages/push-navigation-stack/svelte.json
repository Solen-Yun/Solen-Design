{"id":"push-navigation-stack","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"PushNavigationStack.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountPushNavigationStack, type PushNavigationStackOptions } from \"../../components/push-navigation-stack/PushNavigationStackEngine.js\";\nimport type { MotionController } from \"../../components/push-navigation-stack/motion-runtime\";\nexport let options: PushNavigationStackOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountPushNavigationStack(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"push-navigation-stack\"></div>\n"}],"core":[{"name":"PushNavigationStackEngine.js","path":"src/components/push-navigation-stack/PushNavigationStackEngine.js"},{"name":"motion-runtime.ts","path":"src/components/push-navigation-stack/motion-runtime.ts"},{"name":"PushNavigationStackEngine.d.ts","path":"src/components/push-navigation-stack/PushNavigationStackEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { PushNavigationStack } from \"solen-design/svelte\";\n</script>\n\n<PushNavigationStack />"}],"api":[{"name":"options","type":"PushNavigationStackOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/push-navigation-stack/SPEC.md","detail":"../../components/push-navigation-stack.json"}