{"id":"agent-composer","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte gsap@3.12.7","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte gsap@3.12.7","pnpm":"pnpm add svelte gsap@3.12.7","yarn":"yarn add svelte gsap@3.12.7","bun":"bun add svelte gsap@3.12.7"},"files":[{"name":"AgentComposer.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAgentComposer, type AgentComposerOptions } from \"../../components/agent-composer/AgentComposerEngine.js\";\nimport type { MotionController } from \"../../components/agent-composer/motion-runtime\";\nexport let options: AgentComposerOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAgentComposer(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"agent-composer\"></div>\n"}],"core":[{"name":"AgentComposerEngine.js","path":"src/components/agent-composer/AgentComposerEngine.js"},{"name":"motion-runtime.ts","path":"src/components/agent-composer/motion-runtime.ts"},{"name":"AgentComposerEngine.d.ts","path":"src/components/agent-composer/AgentComposerEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AgentComposer } from \"solen-design/svelte\";\n</script>\n\n<AgentComposer />"}],"api":[{"name":"options","type":"AgentComposerOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/agent-composer/SPEC.md","detail":"../../components/agent-composer.json"}