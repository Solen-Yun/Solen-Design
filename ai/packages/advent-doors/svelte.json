{"id":"advent-doors","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"AdventDoors.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountAdventDoors, type AdventDoorsOptions } from \"../../components/advent-doors/AdventDoorsEngine.js\";\nimport type { MotionController } from \"../../components/advent-doors/motion-runtime\";\nexport let options: AdventDoorsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountAdventDoors(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"advent-doors\"></div>\n"}],"core":[{"name":"AdventDoorsEngine.js","path":"src/components/advent-doors/AdventDoorsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/advent-doors/motion-runtime.ts"},{"name":"AdventDoorsEngine.d.ts","path":"src/components/advent-doors/AdventDoorsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { AdventDoors } from \"solen-design/svelte\";\n</script>\n\n<AdventDoors />"}],"api":[{"name":"options","type":"AdventDoorsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/advent-doors/SPEC.md","detail":"../../components/advent-doors.json"}