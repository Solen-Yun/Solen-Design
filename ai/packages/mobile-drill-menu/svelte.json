{"id":"mobile-drill-menu","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MobileDrillMenu.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMobileDrillMenu, type MobileDrillMenuOptions } from \"../../components/mobile-drill-menu/MobileDrillMenuEngine.js\";\nimport type { MotionController } from \"../../components/mobile-drill-menu/motion-runtime\";\nexport let options: MobileDrillMenuOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMobileDrillMenu(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"mobile-drill-menu\"></div>\n"}],"core":[{"name":"MobileDrillMenuEngine.js","path":"src/components/mobile-drill-menu/MobileDrillMenuEngine.js"},{"name":"motion-runtime.ts","path":"src/components/mobile-drill-menu/motion-runtime.ts"},{"name":"MobileDrillMenuEngine.d.ts","path":"src/components/mobile-drill-menu/MobileDrillMenuEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MobileDrillMenu } from \"solen-design/svelte\";\n</script>\n\n<MobileDrillMenu />"}],"api":[{"name":"options","type":"MobileDrillMenuOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/mobile-drill-menu/SPEC.md","detail":"../../components/mobile-drill-menu.json"}