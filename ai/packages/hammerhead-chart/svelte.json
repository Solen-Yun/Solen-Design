{"id":"hammerhead-chart","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"HammerheadChart.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountHammerheadChart, type HammerheadChartOptions } from \"../../components/hammerhead-chart/HammerheadChartEngine.js\";\nimport type { MotionController } from \"../../components/hammerhead-chart/motion-runtime\";\nexport let options: HammerheadChartOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountHammerheadChart(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"hammerhead-chart\"></div>\n"}],"core":[{"name":"HammerheadChartEngine.js","path":"src/components/hammerhead-chart/HammerheadChartEngine.js"},{"name":"motion-runtime.ts","path":"src/components/hammerhead-chart/motion-runtime.ts"},{"name":"HammerheadChartEngine.d.ts","path":"src/components/hammerhead-chart/HammerheadChartEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { HammerheadChart } from \"solen-design/svelte\";\n</script>\n\n<HammerheadChart />"}],"api":[{"name":"options","type":"HammerheadChartOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/hammerhead-chart/SPEC.md","detail":"../../components/hammerhead-chart.json"}