{"id":"fluid-tooltip","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte gsap@3.12.7","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte gsap@3.12.7","pnpm":"pnpm add svelte gsap@3.12.7","yarn":"yarn add svelte gsap@3.12.7","bun":"bun add svelte gsap@3.12.7"},"files":[{"name":"FluidTooltip.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountFluidTooltip, type FluidTooltipOptions } from \"../../components/fluid-tooltip/FluidTooltipEngine.js\";\nimport type { MotionController } from \"../../components/fluid-tooltip/motion-runtime\";\nexport let options: FluidTooltipOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountFluidTooltip(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"fluid-tooltip\"></div>\n"}],"core":[{"name":"FluidTooltipEngine.js","path":"src/components/fluid-tooltip/FluidTooltipEngine.js"},{"name":"motion-runtime.ts","path":"src/components/fluid-tooltip/motion-runtime.ts"},{"name":"FluidTooltipEngine.d.ts","path":"src/components/fluid-tooltip/FluidTooltipEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { FluidTooltip } from \"solen-design/svelte\";\n</script>\n\n<FluidTooltip />"}],"api":[{"name":"options","type":"FluidTooltipOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/fluid-tooltip/SPEC.md","detail":"../../components/fluid-tooltip.json"}