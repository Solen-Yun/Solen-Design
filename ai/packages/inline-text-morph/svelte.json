{"id":"inline-text-morph","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"InlineTextMorph.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountInlineTextMorph, type InlineTextMorphOptions } from \"../../components/inline-text-morph/InlineTextMorphEngine.js\";\nimport type { MotionController } from \"../../components/inline-text-morph/motion-runtime\";\nexport let options: InlineTextMorphOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountInlineTextMorph(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"inline-text-morph\"></div>\n"}],"core":[{"name":"InlineTextMorphEngine.js","path":"src/components/inline-text-morph/InlineTextMorphEngine.js"},{"name":"motion-runtime.ts","path":"src/components/inline-text-morph/motion-runtime.ts"},{"name":"InlineTextMorphEngine.d.ts","path":"src/components/inline-text-morph/InlineTextMorphEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { InlineTextMorph } from \"solen-design/svelte\";\n</script>\n\n<InlineTextMorph />"}],"api":[{"name":"options","type":"InlineTextMorphOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/inline-text-morph/SPEC.md","detail":"../../components/inline-text-morph.json"}