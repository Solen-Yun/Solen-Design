{"id":"domain-connect","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DomainConnect.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDomainConnect, type DomainConnectOptions } from \"../../components/domain-connect/DomainConnectEngine.js\";\nimport type { MotionController } from \"../../components/domain-connect/motion-runtime\";\nexport let options: DomainConnectOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDomainConnect(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"domain-connect\"></div>\n"}],"core":[{"name":"DomainConnectEngine.js","path":"src/components/domain-connect/DomainConnectEngine.js"},{"name":"motion-runtime.ts","path":"src/components/domain-connect/motion-runtime.ts"},{"name":"DomainConnectEngine.d.ts","path":"src/components/domain-connect/DomainConnectEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DomainConnect } from \"solen-design/svelte\";\n</script>\n\n<DomainConnect />"}],"api":[{"name":"options","type":"DomainConnectOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/domain-connect/SPEC.md","detail":"../../components/domain-connect.json"}