{"id":"responsive-preview","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ResponsivePreview.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountResponsivePreview, type ResponsivePreviewOptions } from \"../../components/responsive-preview/ResponsivePreviewEngine.js\";\nimport type { MotionController } from \"../../components/responsive-preview/motion-runtime\";\nexport let options: ResponsivePreviewOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountResponsivePreview(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"responsive-preview\"></div>\n"}],"core":[{"name":"ResponsivePreviewEngine.js","path":"src/components/responsive-preview/ResponsivePreviewEngine.js"},{"name":"motion-runtime.ts","path":"src/components/responsive-preview/motion-runtime.ts"},{"name":"ResponsivePreviewEngine.d.ts","path":"src/components/responsive-preview/ResponsivePreviewEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ResponsivePreview } from \"solen-design/svelte\";\n</script>\n\n<ResponsivePreview />"}],"api":[{"name":"options","type":"ResponsivePreviewOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/responsive-preview/SPEC.md","detail":"../../components/responsive-preview.json"}