{"id":"share-dialog","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ShareDialog.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountShareDialog, type ShareDialogOptions } from \"../../components/share-dialog/ShareDialogEngine.js\";\nimport type { MotionController } from \"../../components/share-dialog/motion-runtime\";\nexport let options: ShareDialogOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountShareDialog(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"share-dialog\"></div>\n"}],"core":[{"name":"ShareDialogEngine.js","path":"src/components/share-dialog/ShareDialogEngine.js"},{"name":"motion-runtime.ts","path":"src/components/share-dialog/motion-runtime.ts"},{"name":"ShareDialogEngine.d.ts","path":"src/components/share-dialog/ShareDialogEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ShareDialog } from \"solen-design/svelte\";\n</script>\n\n<ShareDialog />"}],"api":[{"name":"options","type":"ShareDialogOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/share-dialog/SPEC.md","detail":"../../components/share-dialog.json"}