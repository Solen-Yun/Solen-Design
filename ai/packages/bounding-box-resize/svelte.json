{"id":"bounding-box-resize","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"BoundingBoxResize.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountBoundingBoxResize, type BoundingBoxResizeOptions } from \"../../components/bounding-box-resize/BoundingBoxResizeEngine.js\";\nimport type { MotionController } from \"../../components/bounding-box-resize/motion-runtime\";\nexport let options: BoundingBoxResizeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountBoundingBoxResize(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"bounding-box-resize\"></div>\n"}],"core":[{"name":"BoundingBoxResizeEngine.js","path":"src/components/bounding-box-resize/BoundingBoxResizeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/bounding-box-resize/motion-runtime.ts"},{"name":"BoundingBoxResizeEngine.d.ts","path":"src/components/bounding-box-resize/BoundingBoxResizeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { BoundingBoxResize } from \"solen-design/svelte\";\n</script>\n\n<BoundingBoxResize />"}],"api":[{"name":"options","type":"BoundingBoxResizeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/bounding-box-resize/SPEC.md","detail":"../../components/bounding-box-resize.json"}