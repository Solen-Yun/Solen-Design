{"id":"kinetic-captions","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"KineticCaptions.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountKineticCaptions, type KineticCaptionsOptions } from \"../../components/kinetic-captions/KineticCaptionsEngine.js\";\nimport type { MotionController } from \"../../components/kinetic-captions/motion-runtime\";\nexport let options: KineticCaptionsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountKineticCaptions(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"kinetic-captions\"></div>\n"}],"core":[{"name":"KineticCaptionsEngine.js","path":"src/components/kinetic-captions/KineticCaptionsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/kinetic-captions/motion-runtime.ts"},{"name":"KineticCaptionsEngine.d.ts","path":"src/components/kinetic-captions/KineticCaptionsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { KineticCaptions } from \"solen-design/svelte\";\n</script>\n\n<KineticCaptions />"}],"api":[{"name":"options","type":"KineticCaptionsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/kinetic-captions/SPEC.md","detail":"../../components/kinetic-captions.json"}