{"id":"multi-cursor-builder","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MultiCursorBuilder.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMultiCursorBuilder, type MultiCursorBuilderOptions } from \"../../components/multi-cursor-builder/MultiCursorBuilderEngine.js\";\nimport type { MotionController } from \"../../components/multi-cursor-builder/motion-runtime\";\nexport let options: MultiCursorBuilderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMultiCursorBuilder(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"multi-cursor-builder\"></div>\n"}],"core":[{"name":"MultiCursorBuilderEngine.js","path":"src/components/multi-cursor-builder/MultiCursorBuilderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/multi-cursor-builder/motion-runtime.ts"},{"name":"MultiCursorBuilderEngine.d.ts","path":"src/components/multi-cursor-builder/MultiCursorBuilderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MultiCursorBuilder } from \"solen-design/svelte\";\n</script>\n\n<MultiCursorBuilder />"}],"api":[{"name":"options","type":"MultiCursorBuilderOptions","default":"—","description":"playing / speed / skipIntro / showToolbar / onPhaseChange / onReplay"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/multi-cursor-builder/SPEC.md","detail":"../../components/multi-cursor-builder.json"}