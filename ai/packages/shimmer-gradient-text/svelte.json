{"id":"shimmer-gradient-text","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"ShimmerGradientText.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountShimmerGradientText, type ShimmerGradientTextOptions } from \"../../components/shimmer-gradient-text/ShimmerGradientTextEngine.js\";\nimport type { MotionController } from \"../../components/shimmer-gradient-text/motion-runtime\";\nexport let options: ShimmerGradientTextOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountShimmerGradientText(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"shimmer-gradient-text\"></div>\n"}],"core":[{"name":"ShimmerGradientTextEngine.js","path":"src/components/shimmer-gradient-text/ShimmerGradientTextEngine.js"},{"name":"motion-runtime.ts","path":"src/components/shimmer-gradient-text/motion-runtime.ts"},{"name":"ShimmerGradientTextEngine.d.ts","path":"src/components/shimmer-gradient-text/ShimmerGradientTextEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { ShimmerGradientText } from \"solen-design/svelte\";\n</script>\n\n<ShimmerGradientText />"}],"api":[{"name":"options","type":"ShimmerGradientTextOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/shimmer-gradient-text/SPEC.md","detail":"../../components/shimmer-gradient-text.json"}