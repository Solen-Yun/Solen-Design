{"id":"hide-on-scroll-header","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"HideOnScrollHeader.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountHideOnScrollHeader, type HideOnScrollHeaderOptions } from \"../../components/hide-on-scroll-header/HideOnScrollHeaderEngine.js\";\nimport type { MotionController } from \"../../components/hide-on-scroll-header/motion-runtime\";\nexport let options: HideOnScrollHeaderOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountHideOnScrollHeader(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"hide-on-scroll-header\"></div>\n"}],"core":[{"name":"HideOnScrollHeaderEngine.js","path":"src/components/hide-on-scroll-header/HideOnScrollHeaderEngine.js"},{"name":"motion-runtime.ts","path":"src/components/hide-on-scroll-header/motion-runtime.ts"},{"name":"HideOnScrollHeaderEngine.d.ts","path":"src/components/hide-on-scroll-header/HideOnScrollHeaderEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { HideOnScrollHeader } from \"solen-design/svelte\";\n</script>\n\n<HideOnScrollHeader />"}],"api":[{"name":"options","type":"HideOnScrollHeaderOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/hide-on-scroll-header/SPEC.md","detail":"../../components/hide-on-scroll-header.json"}