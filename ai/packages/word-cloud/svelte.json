{"id":"word-cloud","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"WordCloud.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountWordCloud, type WordCloudOptions } from \"../../components/word-cloud/WordCloudEngine.js\";\nimport type { MotionController } from \"../../components/word-cloud/motion-runtime\";\nexport let options: WordCloudOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountWordCloud(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"word-cloud\"></div>\n"}],"core":[{"name":"WordCloudEngine.js","path":"src/components/word-cloud/WordCloudEngine.js"},{"name":"motion-runtime.ts","path":"src/components/word-cloud/motion-runtime.ts"},{"name":"WordCloudEngine.d.ts","path":"src/components/word-cloud/WordCloudEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { WordCloud } from \"solen-design/svelte\";\n</script>\n\n<WordCloud />"}],"api":[{"name":"options","type":"WordCloudOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/word-cloud/SPEC.md","detail":"../../components/word-cloud.json"}