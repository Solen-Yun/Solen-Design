{"id":"story-progress","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StoryProgress.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStoryProgress, type StoryProgressOptions } from \"../../components/story-progress/StoryProgressEngine.js\";\nimport type { MotionController } from \"../../components/story-progress/motion-runtime\";\nexport let options: StoryProgressOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStoryProgress(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"story-progress\"></div>\n"}],"core":[{"name":"StoryProgressEngine.js","path":"src/components/story-progress/StoryProgressEngine.js"},{"name":"motion-runtime.ts","path":"src/components/story-progress/motion-runtime.ts"},{"name":"StoryProgressEngine.d.ts","path":"src/components/story-progress/StoryProgressEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StoryProgress } from \"solen-design/svelte\";\n</script>\n\n<StoryProgress />"}],"api":[{"name":"options","type":"StoryProgressOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/story-progress/SPEC.md","detail":"../../components/story-progress.json"}