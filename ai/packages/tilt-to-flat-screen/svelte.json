{"id":"tilt-to-flat-screen","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"TiltToFlatScreen.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountTiltToFlatScreen, type TiltToFlatScreenOptions } from \"../../components/tilt-to-flat-screen/TiltToFlatScreenEngine.js\";\nimport type { MotionController } from \"../../components/tilt-to-flat-screen/motion-runtime\";\nexport let options: TiltToFlatScreenOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountTiltToFlatScreen(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"tilt-to-flat-screen\"></div>\n"}],"core":[{"name":"TiltToFlatScreenEngine.js","path":"src/components/tilt-to-flat-screen/TiltToFlatScreenEngine.js"},{"name":"motion-runtime.ts","path":"src/components/tilt-to-flat-screen/motion-runtime.ts"},{"name":"TiltToFlatScreenEngine.d.ts","path":"src/components/tilt-to-flat-screen/TiltToFlatScreenEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { TiltToFlatScreen } from \"solen-design/svelte\";\n</script>\n\n<TiltToFlatScreen />"}],"api":[{"name":"options","type":"TiltToFlatScreenOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/tilt-to-flat-screen/SPEC.md","detail":"../../components/tilt-to-flat-screen.json"}