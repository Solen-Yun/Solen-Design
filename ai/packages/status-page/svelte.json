{"id":"status-page","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StatusPage.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStatusPage, type StatusPageOptions } from \"../../components/status-page/StatusPageEngine.js\";\nimport type { MotionController } from \"../../components/status-page/motion-runtime\";\nexport let options: StatusPageOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStatusPage(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"status-page\"></div>\n"}],"core":[{"name":"StatusPageEngine.js","path":"src/components/status-page/StatusPageEngine.js"},{"name":"motion-runtime.ts","path":"src/components/status-page/motion-runtime.ts"},{"name":"StatusPageEngine.d.ts","path":"src/components/status-page/StatusPageEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StatusPage } from \"solen-design/svelte\";\n</script>\n\n<StatusPage />"}],"api":[{"name":"options","type":"StatusPageOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/status-page/SPEC.md","detail":"../../components/status-page.json"}