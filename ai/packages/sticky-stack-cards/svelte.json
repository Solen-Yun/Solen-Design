{"id":"sticky-stack-cards","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"StickyStackCards.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountStickyStackCards, type StickyStackCardsOptions } from \"../../components/sticky-stack-cards/StickyStackCardsEngine.js\";\nimport type { MotionController } from \"../../components/sticky-stack-cards/motion-runtime\";\nexport let options: StickyStackCardsOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountStickyStackCards(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"sticky-stack-cards\"></div>\n"}],"core":[{"name":"StickyStackCardsEngine.js","path":"src/components/sticky-stack-cards/StickyStackCardsEngine.js"},{"name":"motion-runtime.ts","path":"src/components/sticky-stack-cards/motion-runtime.ts"},{"name":"StickyStackCardsEngine.d.ts","path":"src/components/sticky-stack-cards/StickyStackCardsEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { StickyStackCards } from \"solen-design/svelte\";\n</script>\n\n<StickyStackCards />"}],"api":[{"name":"options","type":"StickyStackCardsOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/sticky-stack-cards/SPEC.md","detail":"../../components/sticky-stack-cards.json"}