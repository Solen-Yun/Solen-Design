{"id":"gift-box","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"GiftBox.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountGiftBox, type GiftBoxOptions } from \"../../components/gift-box/GiftBoxEngine.js\";\nimport type { MotionController } from \"../../components/gift-box/motion-runtime\";\nexport let options: GiftBoxOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountGiftBox(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"gift-box\"></div>\n"}],"core":[{"name":"GiftBoxEngine.js","path":"src/components/gift-box/GiftBoxEngine.js"},{"name":"motion-runtime.ts","path":"src/components/gift-box/motion-runtime.ts"},{"name":"GiftBoxEngine.d.ts","path":"src/components/gift-box/GiftBoxEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { GiftBox } from \"solen-design/svelte\";\n</script>\n\n<GiftBox />"}],"api":[{"name":"options","type":"GiftBoxOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/gift-box/SPEC.md","detail":"../../components/gift-box.json"}