{"id":"morphing-cursor","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"MorphingCursor.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountMorphingCursor, type MorphingCursorOptions } from \"../../components/morphing-cursor/MorphingCursorEngine.js\";\nimport type { MotionController } from \"../../components/morphing-cursor/motion-runtime\";\nexport let options: MorphingCursorOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountMorphingCursor(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"morphing-cursor\"></div>\n"}],"core":[{"name":"MorphingCursorEngine.js","path":"src/components/morphing-cursor/MorphingCursorEngine.js"},{"name":"motion-runtime.ts","path":"src/components/morphing-cursor/motion-runtime.ts"},{"name":"MorphingCursorEngine.d.ts","path":"src/components/morphing-cursor/MorphingCursorEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { MorphingCursor } from \"solen-design/svelte\";\n</script>\n\n<MorphingCursor />"}],"api":[{"name":"options","type":"MorphingCursorOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/morphing-cursor/SPEC.md","detail":"../../components/morphing-cursor.json"}