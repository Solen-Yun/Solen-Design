{"id":"ink-spread-carousel","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"InkSpreadCarousel.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountInkSpreadCarousel, type InkSpreadCarouselOptions } from \"../../components/ink-spread-carousel/InkSpreadCarouselEngine.js\";\nimport type { MotionController } from \"../../components/ink-spread-carousel/motion-runtime\";\nexport let options: InkSpreadCarouselOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountInkSpreadCarousel(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"ink-spread-carousel\"></div>\n"}],"core":[{"name":"InkSpreadCarouselEngine.js","path":"src/components/ink-spread-carousel/InkSpreadCarouselEngine.js"},{"name":"motion-runtime.ts","path":"src/components/ink-spread-carousel/motion-runtime.ts"},{"name":"InkSpreadCarouselEngine.d.ts","path":"src/components/ink-spread-carousel/InkSpreadCarouselEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { InkSpreadCarousel } from \"solen-design/svelte\";\n</script>\n\n<InkSpreadCarousel />"}],"api":[{"name":"options","type":"InkSpreadCarouselOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/ink-spread-carousel/SPEC.md","detail":"../../components/ink-spread-carousel.json"}