{"id":"dot-globe","framework":"svelte","frameworkName":"Svelte","install":"npm install solen-design svelte","dependencies":{"note":"上方安装命令会自动添加这些依赖。如果手动复制源码，请自行安装。","npm":"npm install svelte","pnpm":"pnpm add svelte","yarn":"yarn add svelte","bun":"bun add svelte"},"files":[{"name":"DotGlobe.svelte","code":"<script lang=\"ts\">\nimport { onMount } from \"svelte\";\nimport { mountDotGlobe, type DotGlobeOptions } from \"../../components/dot-globe/DotGlobeEngine.js\";\nimport type { MotionController } from \"../../components/dot-globe/motion-runtime\";\nexport let options: DotGlobeOptions = {};\nlet host: HTMLDivElement;\nlet controller: MotionController | undefined;\nonMount(() => {\n  const instance = mountDotGlobe(host, options);\n  controller = instance;\n  return () => { instance.destroy(); controller = undefined; };\n});\n$: controller?.update(options);\n</script>\n\n<div bind:this={host} class={$$restProps.class} data-motion-component=\"dot-globe\"></div>\n"}],"core":[{"name":"DotGlobeEngine.js","path":"src/components/dot-globe/DotGlobeEngine.js"},{"name":"motion-runtime.ts","path":"src/components/dot-globe/motion-runtime.ts"},{"name":"DotGlobeEngine.d.ts","path":"src/components/dot-globe/DotGlobeEngine.d.ts"}],"usage":[{"file":"App.svelte","code":"<script>\n  import { DotGlobe } from \"solen-design/svelte\";\n</script>\n\n<DotGlobe />"}],"api":[{"name":"options","type":"DotGlobeOptions","default":"—","description":"组件选项"},{"name":"class","type":"string","default":"—","description":"宿主元素的类名"}],"spec":"src/components/dot-globe/SPEC.md","detail":"../../components/dot-globe.json"}